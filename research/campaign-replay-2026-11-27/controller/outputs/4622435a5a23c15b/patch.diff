@@ -0,0 +1,50 @@
+// @vitest-environment jsdom
+import { cleanup, fireEvent, render } from '@testing-library/react';
+import { afterEach, expect, it, vi } from 'vitest';
+import { TransportBar } from './TransportBar';
+
+afterEach(cleanup);
+
+const controls = [
+  { name: 'Tempo', raised: 135, minimum: 60 },
+  { name: 'Swing', raised: 59, minimum: 0 },
+] as const;
+
+function renderSlider(name: string) {
+  const edits: Array<[string, number]> = [];
+  const view = render(
+    <TransportBar
+      isPlaying={false}
+      tempo={120}
+      swing={50}
+      onPlayPause={vi.fn()}
+      onTempoChange={value => edits.push(['Tempo', value])}
+      onSwingChange={value => edits.push(['Swing', value])}
+    />,
+  );
+  return { slider: view.getByRole('slider', { name }), edits };
+}
+
+it.each(controls)('sends consecutive $name edits during a touch drag', ({ name, raised, minimum }) => {
+  const { slider, edits } = renderSlider(name);
+  fireEvent.touchStart(slider, { touches: [{ clientY: 100 }] });
+  fireEvent.touchMove(slider, { touches: [{ clientY: 70 }] });
+  expect(edits).toEqual([[name, raised]]);
+
+  fireEvent.touchMove(slider, { touches: [{ clientY: 300 }] });
+  expect(edits).toEqual([[name, raised], [name, minimum]]);
+  fireEvent.touchEnd(slider);
+});
+
+it.each(controls)('ignores secondary-button $name drags and reports a primary-button drag', ({ name, raised }) => {
+  const { slider, edits } = renderSlider(name);
+  fireEvent.mouseDown(slider, { button: 2, buttons: 2, clientY: 100 });
+  fireEvent.mouseMove(slider, { buttons: 2, clientY: 70 });
+  fireEvent.mouseUp(slider, { button: 2 });
+  expect(edits).toEqual([]);
+
+  fireEvent.mouseDown(slider, { button: 0, buttons: 1, clientY: 100 });
+  fireEvent.mouseMove(slider, { buttons: 1, clientY: 70 });
+  expect(edits).toEqual([[name, raised]]);
+  fireEvent.mouseUp(slider, { button: 0 });
+});
