     1	// Per-file temporary directories that are removed after the file's tests, so
     2	// suites stop leaking fixtures into the shared OS temp root.
     3	
     4	import { afterAll } from 'bun:test'
     5	import { mkdtempSync, rmSync, writeFileSync } from 'node:fs'
     6	import { tmpdir } from 'node:os'
     7	import { join } from 'node:path'
     8	
     9	export interface TempDirs {
    10	  /** A fresh directory under the OS temp root, removed after the file's tests. */
    11	  dir(prefix?: string): string
    12	  /** Write `content` to `name` inside a fresh directory and return its path. */
    13	  file(name: string, content: string): string
    14	}
    15	
    16	/** Call once at a test file's top level; registers the cleanup hook. */
    17	export function useTempDirs(prefix = 'am-test-'): TempDirs {
    18	  const created: string[] = []
    19	  afterAll(() => {
    20	    for (const dir of created.splice(0)) rmSync(dir, { recursive: true, force: true })
    21	  })
    22	  const dir = (dirPrefix = prefix): string => {
    23	    const path = mkdtempSync(join(tmpdir(), dirPrefix))
    24	    created.push(path)
    25	    return path
    26	  }
    27	  return {
    28	    dir,
    29	    file(name, content) {
    30	      const path = join(dir(), name)
    31	      writeFileSync(path, content)
    32	      return path
    33	    },
    34	  }
    35	}
     1	// One in-process CLI capture for tests that call runCli directly: stdout and
     2	// stderr are collected (strings or bytes) and always restored, even on throw.
     3	
     4	export interface CapturedCli {
     5	  code: number
     6	  out: string
     7	  err: string
     8	}
     9	
    10	function intercept(): { result: (code: number) => CapturedCli; restore: () => void } {
    11	  const out: string[] = []
    12	  const err: string[] = []
    13	  const decoder = new TextDecoder()
    14	  const text = (chunk: unknown) => (chunk instanceof Uint8Array ? decoder.decode(chunk) : String(chunk))
    15	  const originalOut = process.stdout.write
    16	  const originalErr = process.stderr.write
    17	  process.stdout.write = ((chunk: unknown) => { out.push(text(chunk)); return true }) as typeof process.stdout.write
    18	  process.stderr.write = ((chunk: unknown) => { err.push(text(chunk)); return true }) as typeof process.stderr.write
    19	  return {
    20	    result: code => ({ code, out: out.join(''), err: err.join('') }),
    21	    restore: () => {
    22	      process.stdout.write = originalOut
    23	      process.stderr.write = originalErr
    24	    },
    25	  }
    26	}
    27	
    28	export function captureCli(run: () => number | Promise<number>): CapturedCli {
    29	  const capture = intercept()
    30	  try {
    31	    const code = run()
    32	    if (typeof code !== 'number') throw new Error('Use captureCliAsync for streaming commands')
    33	    return capture.result(code)
    34	  } finally {
    35	    capture.restore()
    36	  }
    37	}
    38	
    39	/** The same capture around an async entry point (e.g. runAmCli). */
    40	export async function captureCliAsync(run: () => Promise<number>): Promise<CapturedCli> {
    41	  const capture = intercept()
    42	  try {
    43	    return capture.result(await run())
    44	  } finally {
    45	    capture.restore()
    46	  }
    47	}
