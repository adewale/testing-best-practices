     1	name: Qualify canonical CI
     2	
     3	on:
     4	  workflow_call:
     5	    inputs:
     6	      commit:
     7	        type: string
     8	        required: true
     9	      required:
    10	        type: boolean
    11	        default: true
    12	    outputs:
    13	      qualified:
    14	        value: ${{ jobs.qualify.outputs.qualified }}
    15	
    16	permissions:
    17	  actions: read
    18	  contents: read
    19	
    20	jobs:
    21	  qualify:
    22	    runs-on: ubuntu-latest
    23	    timeout-minutes: 2
    24	    outputs:
    25	      qualified: ${{ steps.proof.outputs.qualified }}
    26	    steps:
    27	      - name: Require full canonical CI qualification
    28	        id: proof
    29	        env:
    30	          GH_TOKEN: ${{ github.token }}
    31	          EXPECTED_SHA: ${{ inputs.commit }}
    32	          REQUIRE_QUALIFICATION: ${{ inputs.required }}
    33	        run: |
    34	          runs="$(timeout 20s gh api -X GET \
    35	            "repos/$GITHUB_REPOSITORY/actions/workflows/ci.yml/runs" \
    36	            -f head_sha="$EXPECTED_SHA" -f branch=main -f status=success -f per_page=100)"
    37	          eligible_runs="$(jq -r --arg sha "$EXPECTED_SHA" '
    38	            .workflow_runs[] | select(.head_sha == $sha and .head_branch == "main" and .conclusion == "success")
    39	            | .id | select(type == "number" and floor == .)
    40	          ' <<< "$runs")"
    41	          # The test aggregate requires every runtime lane; CI complete also
    42	          # checks the selected mode and label-approval maintenance.
    43	          for run_id in $eligible_runs; do
    44	            jobs="$(timeout 20s gh api --paginate -X GET \
    45	              "repos/$GITHUB_REPOSITORY/actions/runs/$run_id/jobs" -f filter=latest -f per_page=100)"
    46	            qualified="$(jq -s '[.[].jobs[]] as $jobs |
    47	              all("test", "CI complete"; . as $name |
    48	                any($jobs[]; .name == $name and .conclusion == "success"))' <<< "$jobs")"
    49	            if [[ "$qualified" == true ]]; then
    50	              echo "qualified=true" >> "$GITHUB_OUTPUT"
    51	              echo "Full canonical CI passed for $EXPECTED_SHA in run $run_id"
    52	              exit 0
    53	            fi
    54	          done
    55	          echo "qualified=false" >> "$GITHUB_OUTPUT"
    56	          if [[ "$REQUIRE_QUALIFICATION" == true ]]; then
    57	            echo "::error::Dispatch full ci.yml on main for $EXPECTED_SHA before publishing or manually deploying."
    58	            exit 1
    59	          fi
    60	          echo "::notice::No full canonical CI qualification exists for $EXPECTED_SHA; deployment skipped."
    61	          echo "### Deployment skipped: no full canonical CI for $EXPECTED_SHA" >> "$GITHUB_STEP_SUMMARY"
