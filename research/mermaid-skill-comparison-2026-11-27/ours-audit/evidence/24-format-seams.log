   302	const initVars = (body: string, themeVariables: Record<string, unknown>): string =>
   303	  `%%{init: ${JSON.stringify({ themeVariables })}}%%\n${body}`
   304	
   305	const shown = (value: unknown): string => typeof value === 'string' ? value : JSON.stringify(value)
   306	const refusal = (path: string, value: unknown): string =>
   307	  `${path}: ${JSON.stringify(shown(value))} is not a CSS color`
   308	const renderFailed = (reason: string) => ({ code: 'RENDER_FAILED' as const, reason: expect.stringContaining(reason), origin: 'config' as const })
   309	
   310	function diagnosticFor(path: string, value: unknown): Record<string, string> {
   311	  return path.startsWith('themeVariables.')
   312	    ? { code: 'INVALID_THEME_COLOR', key: path.slice('themeVariables.'.length), value: shown(value) }
   313	    : { code: 'INVALID_CONFIG_COLOR', path, value: shown(value) }
   314	}
