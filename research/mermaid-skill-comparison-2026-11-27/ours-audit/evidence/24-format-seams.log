   329	/** One named refusal on every public route. PNG, browser-lazy, CLI and MCP load
   330	 * heavier machinery, so callers run this once per family probe, not per key. */
   331	async function expectRefusedOnEveryRoute(
   332	  source: string,
   333	  options: RenderOptions | undefined,
   334	  named: string,
   335	  diagnostic: Record<string, string>,
   336	): Promise<void> {
   337	  expect(() => renderMermaidSVG(source, options), 'svg').toThrow(named)
   338	  expect(() => renderMermaidPNG(source, options), 'png').toThrow(named)
   339	  await expect(renderMermaidSVGAsync(source, options)).rejects.toThrow(named)
   340	  for (const colorMode of ['none', 'ansi16', 'ansi256', 'truecolor', 'html'] as const) {
   341	    expect(() => renderMermaidASCII(source, { ...options, colorMode }), colorMode).toThrow(named)
   342	  }
   343	  expect(verifyMermaid(source, { renderOptions: options }).warnings, 'verify').toContainEqual(renderFailed(named))
   344	  const parsed = parseRegisteredMermaid(source)
   345	  expect(parsed.ok).toBe(true)
   346	  if (parsed.ok) {
   347	    expect(verifyMermaid(parsed.value, { renderOptions: options }).warnings, 'verify parsed').toContainEqual(renderFailed(named))
   348	  }
   349	  for (const format of ['svg', 'ascii', 'unicode'] as const) {
   350	    expect(runBatchLine(JSON.stringify({ op: 'render', source, options: { ...options, format } }), 0), `cli ${format}`)
   351	      .toMatchObject({ ok: false, error: { ...diagnostic, message: expect.stringContaining(named) } })
   352	  }
   353	  for (const tool of ['render_svg', 'render_ascii', 'render_png']) {
   354	    expect(await mcpRender(tool, source, options), `mcp ${tool}`).toMatchObject({ ok: false, error: diagnostic })
   355	  }
   356	  expect(projectRenderErrorDiagnostic({ ...diagnostic, message: 'forged' }), 'forged diagnostic')
   357	    .toEqual({ code: 'RENDER_FAILED', message: 'Rendering failed' })
   358	}
