   316	async function mcpRender(tool: string, source: string, options?: RenderOptions): Promise<unknown> {
   317	  const response = await handleHostedRequest(
   318	    { jsonrpc: '2.0', id: 1, method: 'tools/call', params: { name: tool, arguments: { source, ...(options ? { options } : {}) } } },
   319	    {
   320	      async execute() { return { ok: true, value: null, logs: [] } },
   321	      async renderPng(input, opts) {
   322	        return { ...renderMermaidPNGWithReceipt(input, opts), warnings: [] }
   323	      },
   324	    },
   325	  )
   326	  return JSON.parse((response?.result as { content: Array<{ text: string }> }).content[0]!.text)
   327	}
