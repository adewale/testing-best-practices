    33	      - name: Classify the changes in the tested checkout
    34	        id: scope
    35	        env:
    36	          REQUEST_LAYOUT: ${{ inputs.layout_evidence == true }}
    37	        run: |
    38	          flags=()
    39	          if [[ "$REQUEST_LAYOUT" == true ]]; then flags+=(--layout-evidence); fi
    40	          base=''
    41	          case "$GITHUB_EVENT_NAME" in
    42	            pull_request)
    43	              # Checkout's first parent is the actual tested base, including
    44	              # base updates after the PR's original event snapshot.
    45	              parents=$(git rev-list --parents -n 1 HEAD)
    46	              if [[ $(wc -w <<< "$parents") -eq 3 ]]; then base=$(git rev-parse HEAD^1); fi
    47	              ;;
    48	            push) base=$(jq -r '.before // ""' "$GITHUB_EVENT_PATH") ;;
    49	          esac
    50	          if [[ "$base" =~ ^[0-9a-f]{40}$ ]] && git cat-file -e "$base^{commit}" 2>/dev/null; then
    51	            git diff --name-only --no-renames -z "$base" HEAD -- | bun scripts/ci/change-scope.ts "${flags[@]}"
    52	          else
    53	            # Dispatches (including release qualification), new branches and
    54	            # missing history always run every required runtime lane.
    55	            bun scripts/ci/change-scope.ts --full "${flags[@]}" </dev/null
    56	          fi
