    92	interface AuthoredLine { readonly text: string; readonly eol: string }
    93	
    94	/** Authored lines are skipped as owners: they hold no family statement. */
    95	const inert = (text: string) => !text.trim() || text.trim().startsWith('%%')
    96	const leading = (text: string) => /^[ \t]*/.exec(text)![0]
    97	/** Canonical nesting depth; a verbatim tab counts as one two-space level. */
    98	const depthOf = (text: string) => leading(text).replace(/\t/g, '  ').length
    99	const WORDS = /[\p{L}\p{N}_]+/gu
   100	const isWord = (char: string | undefined) => char !== undefined && /[\p{L}\p{N}_]/u.test(char)
   101	const MAX_DIFF_CELLS = 4_000_000
   102	
   103	function splitLines(text: string): AuthoredLine[] {
   104	  const lines: AuthoredLine[] = []
   105	  const pattern = /\r\n|\n|\r/g
   106	  let start = 0
   107	  for (let match = pattern.exec(text); match; match = pattern.exec(text)) {
   108	    lines.push({ text: text.slice(start, match.index), eol: match[0] })
   109	    start = match.index + match[0].length
   110	  }
   111	  if (start < text.length) lines.push({ text: text.slice(start), eol: '' })
   112	  return lines
   113	}
