   115	/** Canonical statements of a structured diagram, header first. */
   116	function statements(d: ParsedDiagram): string[] | undefined {
   117	  if (d.body.kind === 'opaque' || d.body.kind === 'preserved' || d.body.kind === 'extension') return undefined
   118	  try {
   119	    return serializeBodyStatements(d).replace(/\n+$/, '').split('\n')
   120	  } catch {
   121	    return undefined
   122	  }
   123	}
