   131	/** The same diagram: identical facts (which carry every ordered meaning) and
   132	 * the same canonical statements, whose incidental order may differ. */
   133	export function sameProjectedDiagram(candidate: ParsedDiagram, expected: ParsedDiagram, expectedFacts = describeMermaidFacts(expected), expectedLines = statements(expected)): boolean {
   134	  if (candidate.kind !== expected.kind || candidate.body.kind !== expected.body.kind || !expectedLines) return false
   135	  const lines = statements(candidate)
   136	  if (!lines) return false
   137	  const sorted = (values: readonly string[]) => [...values].sort()
   138	  if (!sameSourceMeaning(sorted(describeMermaidFacts(candidate)), sorted(expectedFacts))) return false
   139	  // A segment kept verbatim and the same statements written canonically differ
   140	  // only in spacing; the facts above still compare every label exactly.
   141	  const spelled = (values: readonly string[]) => sorted(values.map(line => line.replace(/\s+/g, '')).filter(Boolean))
   142	  if (!sameSourceMeaning(spelled(lines), spelled(expectedLines))) return false
   143	  const meta = (d: ParsedDiagram) => ({ frontmatter: d.meta.frontmatter, accessibility: d.meta.accessibility, init: d.meta.initDirectives.map(layer => layer.parsed) })
   144	  return sameSourceMeaning(meta(candidate), meta(expected))
   145	}
