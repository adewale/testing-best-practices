    82	/** How a source-preserving edit of a structured body was written. */
    83	export interface SourceEditPreservation {
    84	  /** `local`: every authored line the edit does not touch is copied byte for
    85	   * byte. `canonical`: no local splice reproduced the edit, so the whole
    86	   * diagram was re-serialized canonically (comments and spelling may change). */
