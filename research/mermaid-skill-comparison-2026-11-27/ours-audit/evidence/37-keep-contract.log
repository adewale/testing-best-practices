   343	/** Batches up to this many ops are projected op by op when the whole batch
   344	 * does not project; each step re-traces every authored line, so a larger
   345	 * batch falls back to canonical output instead. */
   346	const OP_BY_OP_PROJECTION_LIMIT = 16
   347	
   348	/**
   349	 * Write `after`, the committed canonical result of typed edits to `before`,
   350	 * as a local change to the source `before` was parsed from. The whole batch
   351	 * is projected at once; when that does not read back as `after`, a batch of
   352	 * at most OP_BY_OP_PROJECTION_LIMIT ops is projected op by op. A diagram
   353	 * with no authored source, or an edit no local change reproduces, is
   354	 * written canonically with the reason.
   355	 */
   356	export function preserveStructuredEdit(before: ParsedDiagram, after: ParsedDiagram, ops: readonly unknown[] = []): SourceMutationResult {
   357	  const canonical = (reason: string): SourceMutationResult => ({ source: serializeMermaid(after), diagram: after, preservation: { method: 'canonical', reason } })
   358	  const authored = authoredSourceOf(before.source)
   359	  if (authored === undefined) return canonical('the diagram was not parsed from source, so there are no authored lines to keep')
   360	  const read = (source: string) => {
   361	    const parsed = parseMermaid(source)
   362	    return parsed.ok && parsed.value.kind === before.kind && parsed.value.body.kind === before.body.kind ? parsed.value : undefined
   363	  }
   364	  const original = read(authored)
   365	  if (!original) return canonical('the authored source no longer reads as this diagram')
   366	  const whole = projectStructuredEdit(authored, original, after)
   367	  if (whole.ok) return { ...whole.value, preservation: { method: 'local' } }
   368	  if (ops.length > OP_BY_OP_PROJECTION_LIMIT) return canonical(`${whole.error}; batches of more than ${OP_BY_OP_PROJECTION_LIMIT} operations are not projected one by one`)
   369	  if (ops.length > 1) {
   370	    let source = authored, current = original
   371	    for (const op of ops) {
   372	      const checked = hasOpSchema(current.kind) ? admittedOp(current.kind, op) : ok(op as AnyMutationOp)
   373	      const next = checked.ok ? applyOneMutation(current, checked.value) : checked
   374	      const projected = next.ok ? projectStructuredEdit(source, current, next.value) : undefined
   375	      if (!projected?.ok) break
   376	      ;({ source, diagram: current } = projected.value)
   377	    }
   378	    if (current !== original && sameProjectedDiagram(current, after)) return { source, diagram: current, preservation: { method: 'local' } }
   379	  }
   380	  return canonical(whole.error)
   381	}
