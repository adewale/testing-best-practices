   125	function counts(lines: readonly string[]): Map<string, number> {
   126	  const result = new Map<string, number>()
   127	  for (const line of lines) if (line.trim()) result.set(line.trim(), (result.get(line.trim()) ?? 0) + 1)
   128	  return result
   129	}
