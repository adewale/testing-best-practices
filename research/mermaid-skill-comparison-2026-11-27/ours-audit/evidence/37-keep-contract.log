   626	    if (depth > 8 || typeof value === 'function') return undefined
   627	    if (value instanceof Map) return [...value].map(([key, entry]) => [key, plain(entry, depth + 1)])
   628	    if (value instanceof Set) return [...value].map(entry => plain(entry, depth + 1))
   629	    if (Array.isArray(value)) return value.map(entry => plain(entry, depth + 1))
   630	    if (value && typeof value === 'object') return Object.fromEntries(Object.entries(value).filter(([key]) => key !== 'domId').map(([key, entry]) => [key, plain(entry, depth + 1)]))
   631	    return value
   632	  }
   633	  const db = diagram.db, out: Record<string, unknown> = {}
   634	  const names = new Set([...Object.keys(db), ...Object.getOwnPropertyNames(Object.getPrototypeOf(db))])
   635	  for (const name of [...names].sort()) {
   636	    if (!/^get[A-Z]/.test(name) || typeof db[name] !== 'function' || db[name].length !== 0) continue
   637	    try { out[name] = JSON.parse(JSON.stringify(plain(db[name].call(db)))) } catch { /* not a data getter */ }
   638	  }
   639	  return out
   640	}
