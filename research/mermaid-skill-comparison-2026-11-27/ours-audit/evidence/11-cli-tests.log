     1	import { describe, expect, test } from 'bun:test'
     2	import { renderSourceToFormatWithReceipt, runBatchLine } from '../cli/index.ts'
     3	import { spawn } from 'node:child_process'
     4	import { createInterface } from 'node:readline'
     5	import { once } from 'node:events'
     6	
     7	const source = 'flowchart LR\n  A --> B'
     8	
     9	function render(options: Record<string, unknown>, lineIndex = 0) {
    10	  return runBatchLine(JSON.stringify({ op: 'render', source, options }), lineIndex)
    11	}
    12	
    13	describe('batch render uses the canonical render contract', () => {
    14	  test('live JSONL emits before EOF and preserves UTF-8, nonblank indices and per-line errors', async () => {
    15	    const child = spawn(process.execPath, ['src/cli/am-bin.ts', 'batch', '--jsonl'], { stdio: ['pipe', 'pipe', 'pipe'] })
    16	    const closed = once(child, 'close')
    17	    const lines = createInterface({ input: child.stdout })[Symbol.asyncIterator]()
    18	    let stderr = ''
    19	    child.stderr.setEncoding('utf8').on('data', text => { stderr += text })
    20	    const deadline = async <T>(promise: Promise<T>): Promise<T> => {
    21	      let timer: ReturnType<typeof setTimeout>
    22	      const result = await Promise.race([promise.then(value => ({ kind: 'response' as const, value })), new Promise<{ kind: 'timeout' }>(resolve => {
    23	        timer = setTimeout(() => resolve({ kind: 'timeout' }), 10000)
    24	      })]).finally(() => clearTimeout(timer))
    25	      expect(result.kind).toBe('response')
    26	      if (result.kind !== 'response') throw new Error('batch did not respond while stdin remained open')
    27	      return result.value
    28	    }
    29	    try {
    30	      const request = Buffer.from('\r\n  \n' + JSON.stringify({ op: 'render', source: 'flowchart LR\n A["λ🚀"] --> B', options: { idPrefix: 'caller-' } }) + '\r\n')
    31	      const split = request.indexOf(Buffer.from('🚀')) + 2
    32	      child.stdin.write(request.subarray(0, split))
    33	      await new Promise(resolve => setTimeout(resolve, 10))
    34	      child.stdin.write(request.subarray(split))
    35	      const first = await deadline(lines.next())
    36	      expect(first.done).toBe(false)
    37	      const value = JSON.parse(first.value!)
    38	      expect(value.ok).toBe(true)
    39	      expect(value.data.svg).toContain('λ🚀')
    40	      expect(value.data.svg).toContain('d0-caller-')
    41	      expect(value.data.receipt.output).toBe('svg')
    42	      // Error lines count towards the namespace; blank lines do not. The last
    43	      // request deliberately has no trailing newline.
    44	      child.stdin.end('\n{bad json}\n \r\n' + JSON.stringify({ op: 'render', source, options: { idPrefix: 'caller-' } }))
    45	      const bad = JSON.parse((await deadline(lines.next())).value!)
    46	      expect(bad).toMatchObject({ ok: false, error: { code: 'INVALID_JSON' } })
    47	      const last = JSON.parse((await deadline(lines.next())).value!)
    48	      expect(last.ok).toBe(true)
    49	      expect(last.data.svg).toContain('d2-caller-')
    50	      expect((await deadline(lines.next())).done).toBe(true)
    51	      expect((await closed)[0]).toBe(0)
    52	      expect(stderr).toBe('')
    53	    } finally {
    54	      child.stdin.destroy()
    55	      child.kill()
    56	      await closed
    57	    }
    58	  })
