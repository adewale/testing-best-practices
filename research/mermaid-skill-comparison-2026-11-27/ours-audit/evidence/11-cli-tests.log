    86	    }))
    87	    expect(render({ ascii: true })).toEqual(expect.objectContaining({
    88	      ok: false,
    89	      error: expect.objectContaining({ code: 'INVALID_OPTIONS', message: expect.stringContaining('ascii') }),
    90	    }))
    91	  })
    92	})
