     7	import { captureCli as capture } from './helpers/cli-capture.ts'
     8	import { useTempDirs } from './helpers/temp-dir.ts'
     9	
    10	const temp = useTempDirs('am-multi-input-')
    11	const tmp = (content: string): string => temp.file('input.mmd', content)
    12	
    13	describe('#930 pathname watch lifecycle', () => {
    14	  test('observes atomic rename-over saves and subsequent writes to the replacement inode', async () => {
    15	    // Watch an owned directory, not the shared OS /tmp root: Bun's Linux
    16	    // fs.watch implementation may inspect unrelated protected service dirs.
    17	    const dir = temp.dir('am-watch-')
    18	    const input = join(dir, 'input.mmd')
    19	    writeFileSync(input, 'flowchart TD\n A --> B')
    20	    const replacement = `${input}.replacement`
    21	    const observed: string[] = []
    22	    let notify: (() => void) | undefined
    23	    const waitForChange = () =>
    24	      new Promise<void>((resolve, reject) => {
    25	        const timeout = setTimeout(() => reject(new Error('watch change timed out')), 10_000)
    26	        notify = () => {
    27	          clearTimeout(timeout)
    28	          resolve()
    29	        }
    30	      })
    31	    const handle = watchPathForChanges(
    32	      input,
    33	      () => {
    34	        observed.push(readFileSync(input, 'utf8'))
    35	        notify?.()
    36	        notify = undefined
    37	      },
    38	      5,
    39	    )
    40	    try {
    41	      // Yield once after watcher construction: Linux/Bun may register the
    42	      // inotify subscription on the following event-loop turn under coverage.
    43	      await new Promise(resolve => setTimeout(resolve, 100))
    44	      // Some fs.watch implementations emit an initial metadata notification;
    45	      // the contract under test begins with the authored post-watch save.
    46	      observed.length = 0
    47	      const atomic = waitForChange()
    48	      writeFileSync(replacement, 'flowchart TD\n A --> C')
    49	      renameSync(replacement, input)
    50	      await atomic
    51	
    52	      const subsequent = waitForChange()
    53	      writeFileSync(input, 'flowchart TD\n A --> D')
    54	      await subsequent
    55	      expect(observed).toEqual(['flowchart TD\n A --> C', 'flowchart TD\n A --> D'])
    56	    } finally {
    57	      handle.close()
    58	    }
    59	  })
    60	
    61	  test('metadata polling observes changes when the host event source stays silent', async () => {
    62	    const dir = temp.dir('am-watch-poll-')
    63	    const input = join(dir, 'input.mmd')
    64	    writeFileSync(input, 'flowchart TD\n A --> B')
    65	    const silentWatch = (() => ({ close() {} })) as unknown as typeof fsWatch
    66	    let notify: (() => void) | undefined
    67	    const changed = new Promise<void>((resolve, reject) => {
    68	      const timeout = setTimeout(() => reject(new Error('watch polling timed out')), 2_000)
    69	      notify = () => {
    70	        clearTimeout(timeout)
    71	        resolve()
    72	      }
    73	    })
    74	    const handle = watchPathForChanges(input, () => notify?.(), 5, silentWatch)
    75	    try {
    76	      writeFileSync(input, 'flowchart TD\n A --> C')
    77	      await changed
    78	    } finally {
    79	      handle.close()
    80	    }
    81	  })
    82	})
