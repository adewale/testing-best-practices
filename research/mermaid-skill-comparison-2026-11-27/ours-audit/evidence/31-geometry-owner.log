     1	import type { Direction, MermaidGraph, Point, PositionedEdge, PositionedGroup, PositionedNode } from '../../types.ts'
     2	import type { LabelMetricsStyle } from '../../route-contracts.ts'
     3	import { graphReachability, layoutFlow, nodeCrossCenter, nodeMainStart, rectsOverlap } from '../geometry.ts'
     4	import { positionedEdgeForwardish, sameFlowLayer, nodeInsideGroups, flattenPositionedGroups, rectInsideGroup, expandGroupsForMainShift, moveKeepsGroupContainment, sourceEmissionPort, targetFlowPort, symmetricOffsets, doglegBetween, routeClearOfNodes } from './shared.ts'
     5	import { terminalLabelRunLength, terminalLabelCorridorLength, assignBundledFanoutLabels } from './bundled-labels.ts'
     6	import { hasConstructedBundleRoute, retainConstructedBundleRoutes } from '../bundle-routes.ts'
     7	import { countPointPairCrossings } from '../../shared/edge-crossing-pair.ts'
     8	import { terminalHookLength } from '../route-geometry.ts'
     9	import { laneContextFor, straightLaneFor } from '../route-lanes.ts'
    10	import { labelPaintClearance } from '../../route-contracts.ts'
    11	import { labelHaloExtension, labelRect } from '../../shared/edge-label-geometry.ts'
    12	import { labelSeatPaintContext } from '../graph-paint-support.ts'
    13	
    14	/** A grouped fork cannot grow its corridor. Retain its existing readable
    15	 * seats, or admit a complete replacement against the proposed route paint. */
    16	function seatGroupedFanout(
    17	  proposed: Array<{ edge: PositionedEdge; points: Point[] }>,
    18	  nodes: PositionedNode[], edges: PositionedEdge[], groups: PositionedGroup[],
    19	  direction: Direction, style: LabelMetricsStyle,
    20	): boolean {
    21	  let work = 4_000_000
    22	  const paint = labelSeatPaintContext(nodes, edges, groups, style, units => (work -= units) >= 0)
    23	  if (!paint) return false
    24	  const clearance = labelPaintClearance({ nodes, edges, groups }, style)
    25	  const ignored = new Set(proposed.map(({ edge }) => edge))
    26	  const source = nodes.find(node => node.id === proposed[0]!.edge.source)!
    27	  const containers = flattenPositionedGroups(groups).filter(group => rectInsideGroup(source, group))
    28	  const admit = (edge: PositionedEdge, point: Point): boolean => {
    29	    const rect = labelRect({ ...edge, labelPosition: point }, style)
    30	    const halo = rect && clearance.clearPaintRect(rect, labelHaloExtension(edge, style.lineWidth ?? 1), edge)
    31	    return !!halo && containers.every(group => halo.x > group.x && halo.y > group.y
    32	      && halo.x + halo.w < group.x + group.width && halo.y + halo.h < group.y + group.height)
    33	      && paint.clear(edge, point, new Map(), undefined, ignored)
    34	  }
    35	  const complete = () => proposed.every(({ edge }) => !edge.label || !!edge.labelPosition && paint.clear(edge, edge.labelPosition, new Map()))
    36	  const retained = proposed.every(({ edge, points }) => {
    37	    if (!edge.label) return true
    38	    if (!edge.labelPosition || !admit(edge, edge.labelPosition)) return false
    39	    const rect = labelRect(edge, style)!
    40	    return points.some((b, i) => {
    41	      if (!i) return false
    42	      const a = points[i - 1]!
    43	      return a.x === b.x && a.x >= rect.x && a.x <= rect.x + rect.w && rect.y >= Math.min(a.y, b.y) && rect.y + rect.h <= Math.max(a.y, b.y)
    44	        || a.y === b.y && a.y >= rect.y && a.y <= rect.y + rect.h && rect.x >= Math.min(a.x, b.x) && rect.x + rect.w <= Math.max(a.x, b.x)
    45	    })
    46	  })
    47	  return retained && complete() || assignBundledFanoutLabels(proposed, nodes, direction, style, false, admit) && complete()
    48	}
    49	
    50	export function reassignBundledSiblingLabels(
    51	  nodes: PositionedNode[],
    52	  edges: PositionedEdge[],
    53	  bundled: ReadonlySet<PositionedEdge>,
    54	  direction: Direction,
    55	  style: LabelMetricsStyle,
    56	  groups: PositionedGroup[] = [],
    57	): void {
    58	  const nodeMap = new Map(nodes.map(n => [n.id, n]))
    59	  const bySource = new Map<string, PositionedEdge[]>()
    60	  for (const edge of edges) {
    61	    if (!bundled.has(edge) || !edge.label || !positionedEdgeForwardish(edge, nodeMap, direction)) continue
    62	    if (!bySource.has(edge.source)) bySource.set(edge.source, [])
    63	    bySource.get(edge.source)!.push(edge)
    64	  }
    65	  for (const group of bySource.values()) {
    66	    if (group.length < 2 || group.length > 3) continue
    67	    if (new Set(group.map(edge => edge.target)).size < group.length) continue
    68	    const sorted = [...group].sort((a, b) => {
    69	      const aTarget = nodeMap.get(a.target)
    70	      const bTarget = nodeMap.get(b.target)
    71	      if (!aTarget || !bTarget) return (a.edgeIndex ?? 0) - (b.edgeIndex ?? 0)
    72	      return nodeCrossCenter(aTarget, direction) - nodeCrossCenter(bTarget, direction)
    73	    })
    74	    const source = nodeMap.get(sorted[0]!.source)!
    75	    if (source?.shape === 'rectangle' && nodeInsideGroups(source, groups)) {
    76	      const proposed = sorted.map(edge => ({ edge: { ...edge }, points: edge.points }))
    77	      const replacements = new Map(sorted.map((edge, i) => [edge, proposed[i]!.edge]))
    78	      if (seatGroupedFanout(proposed, nodes, edges.map(edge => replacements.get(edge) ?? edge), groups, direction, style)) {
    79	        sorted.forEach((edge, i) => { edge.labelPosition = proposed[i]!.edge.labelPosition })
    80	      }
    81	    } else assignBundledFanoutLabels(sorted.map(edge => ({ edge, points: edge.points })), nodes, direction, style)
    82	  }
    83	}
    84	
    85	/** The ids of every group enclosing `node`, outermost first. */
    86	function containingGroups(node: PositionedNode, groups: PositionedGroup[]): string {
    87	  return flattenPositionedGroups(groups).filter(group => rectInsideGroup(node, group)).map(group => group.id).join('\u0000')
    88	}
    89	
    90	/** The forward edges of a fan-out the symmetric emitter owns, sorted by
    91	 * target cross centre, or undefined. A rectangle or diamond source emits to
    92	 * 2–3 rectangle leaves fed only by it, peers on one rank that do not reach
    93	 * each other; a grouped rectangle source owns only targets in its groups.
    94	 * `raw` is the source's forward edges. */
    95	export function symmetricFanout(
    96	  source: PositionedNode,
    97	  raw: readonly PositionedEdge[],
    98	  edges: readonly PositionedEdge[],
    99	  nodeMap: ReadonlyMap<string, PositionedNode>,
   100	  groups: PositionedGroup[],
   101	  direction: Direction,
   102	  reaches: (from: string, to: string) => boolean,
   103	): PositionedEdge[] | undefined {
   104	  if (raw.length < 2 || raw.length > 3) return undefined
   105	  if (source.shape !== 'rectangle' && source.shape !== 'diamond') return undefined
   106	  const routeOnly = source.shape !== 'diamond' && nodeInsideGroups(source, groups)
   107	  const sorted = [...raw].sort((a, b) => nodeCrossCenter(nodeMap.get(a.target)!, direction) - nodeCrossCenter(nodeMap.get(b.target)!, direction))
   108	  const targets = sorted.map(e => nodeMap.get(e.target)!).filter(Boolean)
   109	  if (targets.length !== sorted.length) return undefined
   110	  const scope = routeOnly ? containingGroups(source, groups) : ''
   111	  // Grouped rectangle forks retain placement; diamond forks may propose new
   112	  // placement, subject to the enclosure checks in placementClear below.
   113	  if (!targets.every(t => t.shape === 'rectangle' && (routeOnly ? containingGroups(t, groups) === scope : source.shape === 'diamond' || !nodeInsideGroups(t, groups)))) return undefined
   114	  // Same-rank gate. Fan-out targets drift apart on the main axis when their
   115	  // label widths differ ("warnings" 97px vs "ok" 60px → ~32px apart), so the
   116	  // tolerance must clear that width-driven drift to see them as peers — while
   117	  // staying below layerSpacing (48) so genuinely different ranks are still
   118	  // rejected. The peer confirmation just below is the real safety net, so
   119	  // loosening this gate cannot equalize non-peers. (Equalizing such peers is
   120	  // exactly the symmetry the diamond/"warnings"/"ok" fan-out wants; verified
   121	  // byte-identical on the corpus, which has no fan-out in the 28–40px band.)
   122	  if (!sameFlowLayer(targets, direction, 40)) return undefined
   123	  if (!targets.every(t => edges.every(e => e.source !== t.id && (e.target !== t.id || e.source === source.id)))) return undefined
   124	  for (let i = 0; i < targets.length; i++) for (let j = 0; j < targets.length; j++) {
   125	    if (i !== j && reaches(targets[i]!.id, targets[j]!.id)) return undefined
   126	  }
   127	  return sorted
   128	}
   129	
   130	export function applySymmetricFanoutEmissions(
   131	  nodes: PositionedNode[],
   132	  edges: PositionedEdge[],
   133	  groups: PositionedGroup[],
   134	  graph: MermaidGraph,
   135	  bundled: Set<PositionedEdge>,
   136	  style: LabelMetricsStyle,
   137	): void {
   138	  const reaches = graphReachability(graph.edges)
   139	  const nodeMap = new Map(nodes.map(n => [n.id, n]))
   140	  const bySource = new Map<string, PositionedEdge[]>()
   141	  for (const edge of edges) {
   142	    if (!positionedEdgeForwardish(edge, nodeMap, graph.direction)) continue
   143	    if (!bySource.has(edge.source)) bySource.set(edge.source, [])
   144	    bySource.get(edge.source)!.push(edge)
   145	  }
   146	  const f = layoutFlow(graph.direction)
   147	  for (const [sourceId, raw] of bySource) {
   148	    const source = nodeMap.get(sourceId)
   149	    const sorted = source && symmetricFanout(source, raw, edges, nodeMap, groups, graph.direction, reaches)
   150	    if (!source || !sorted) continue
   151	    const targets = sorted.map(e => nodeMap.get(e.target)!)
   152	    // A grouped rectangle keeps ELK's target placement: moving a member would
   153	    // need its group refitted. Its fork is still emitted symmetrically, with
   154	    // one shared elbow and level label seats; the terminal runs follow the
   155	    // targets where ELK centred them under the source.
   156	    const routeOnly = source.shape !== 'diamond' && nodeInsideGroups(source, groups)
   157	    if (routeOnly) {
   158	      // The straightener's own lanes stand when they already mirror about the
   159	      // source: a symmetric pair of straight lines needs no constructed fork.
   160	      const { ctx, axis: laneAxis } = laneContextFor(nodes, edges, graph.direction, style, groups)
   161	      const centre = nodeCrossCenter(source, graph.direction)
   162	      const lanes = sorted.map(edge => straightLaneFor(edge, source, nodeMap.get(edge.target)!, ctx, laneAxis))
   163	      if (lanes.every((lane, i) => lane !== null && Math.abs(lane - centre + (lanes[lanes.length - 1 - i]! - centre)) <= 1)) continue
   164	    }
   165	
   166	    const oldTargets = targets.map(t => ({ t, x: t.x, y: t.y, width: t.width, height: t.height }))
   167	    const targetGroups = new Map(targets.map(target => [target.id, flattenPositionedGroups(groups).filter(group => rectInsideGroup(target, group))]))
   168	    const oldGroups = flattenPositionedGroups(groups).map(group => ({ group, x: group.x, y: group.y, width: group.width, height: group.height }))
   169	    const restoreGeometry = () => {
   170	      for (const old of oldTargets) { old.t.x = old.x; old.t.y = old.y; old.t.width = old.width; old.t.height = old.height }
   171	      for (const old of oldGroups) { old.group.x = old.x; old.group.y = old.y; old.group.width = old.width; old.group.height = old.height }
   172	    }
   173	    const maxWidth = Math.max(...targets.map(t => t.width))
   174	    const maxHeight = Math.max(...targets.map(t => t.height))
   175	    const axis = nodeCrossCenter(source, graph.direction)
   176	    const rank = Math.min(...targets.map(t => nodeMainStart(t, graph.direction)))
   177	    const spacing = (f.isHorizontal ? maxHeight : maxWidth) + 28
   178	    const offsets = symmetricOffsets(targets.length, spacing)
   179	    const sourceAlignedCross = source.shape === 'diamond'
   180	      ? sorted.map((_, i) => sourceEmissionPort(source, graph.direction, i, sorted.length)[f.cross])
   181	      : undefined
   182	    const placeTargets = (crossCenters: number[]) => {
   183	      for (let i = 0; i < targets.length; i++) {
   184	        const target = targets[i]!
   185	        target.width = maxWidth
   186	        target.height = maxHeight
   187	        if (f.isHorizontal) {
   188	          target.x = rank
   189	          target.y = crossCenters[i]! - maxHeight / 2
   190	        } else {
   191	          target.x = crossCenters[i]! - maxWidth / 2
   192	          target.y = rank
   193	        }
   194	      }
   195	    }
   196	    if (!routeOnly) placeTargets(sourceAlignedCross ?? offsets.map(offset => axis + offset))
   197	    const targetIds = new Set(targets.map(t => t.id))
   198	    const placementClear = (): boolean => {
   199	      for (let i = 0; i < targets.length; i++) {
   200	        const target = targets[i]!
   201	        if (target.x < 0 || target.y < 0) return false
   202	        // Late fan-out placement must preserve every original enclosure. Main
   203	        // axis expansion below may enlarge a group, but never evict a member.
   204	        if (!targetGroups.get(target.id)!.every(group => rectInsideGroup(target, group))) return false
   205	        for (let j = i + 1; j < targets.length; j++) {
   206	          if (rectsOverlap(target, targets[j]!, 8)) return false
   207	        }
   208	      }
   209	      for (const target of targets) {
   210	        for (const other of nodes) {
   211	          if (targetIds.has(other.id)) continue
   212	          if (rectsOverlap(target, other, 8)) return false
   213	        }
   214	      }
   215	      return true
   216	    }
   217	    let clear = routeOnly || placementClear()
   218	    if (!clear && sourceAlignedCross) {
   219	      placeTargets(offsets.map(offset => axis + offset))
   220	      clear = placementClear()
   221	    }
   222	    if (!clear) {
   223	      restoreGeometry()
   224	      continue
   225	    }
   226	
   227	    const sourceEdge = f.isHorizontal
   228	      ? (f.sourceSide === 'E' ? source.x + source.width : source.x)
