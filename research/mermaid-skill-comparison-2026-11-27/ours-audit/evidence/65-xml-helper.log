     5	/** An independent XML parser, with native resources released after each case. */
     6	export function expectWellFormedXml(svg: string, source: string): void {
     7	  let parseError: string | undefined
     8	  try {
     9	    const document = new Resvg(svg, { font: { loadSystemFonts: false } })
    10	    document.free()
    11	  } catch (error) {
    12	    parseError = error instanceof Error ? error.message : String(error)
