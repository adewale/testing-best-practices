    81	  // Materialize private files from the verified snapshots, never from the
    82	  // original package paths; coverage continues to consume the buffers below.
    83	  const snapshotDirectory = mkdtempSync(join(tmpdir(), 'agentic-mermaid-fonts-'))
    84	  try {
