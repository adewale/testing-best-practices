    92	      snapshotDirectory,
    93	      buffers: Object.freeze(buffers),
    94	      files: Object.freeze(files),
    95	    })
    96	  } catch (error) {
    97	    try { rmSync(snapshotDirectory, { recursive: true, force: true }) } catch { /* retain the original materialization error */ }
