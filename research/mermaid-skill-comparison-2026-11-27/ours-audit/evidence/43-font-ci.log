     1	// PNG font fidelity — the raster font must BE the metrics font.
     2	//
     3	// Text metrics (src/text-metrics.ts) model Inter, and the SVG output requests
     4	// Inter; if the rasterizer draws with a wider face (DejaVu Sans is ~14% wider)
     5	// long labels escape the boxes that were sized for them. The discriminating
     6	// test renders a journey with a long task label and pixel-scans the decoded
     7	// PNG: no glyph ink may appear beyond the task box's right border. Nothing
     8	// legitimate renders right of a single-section, single-task journey box, so
     9	// any ink there is label overflow.
    10	
    11	import { describe, test, expect } from 'bun:test'
    12	import { existsSync, readFileSync, writeFileSync } from 'node:fs'
    13	import { join } from 'node:path'
    14	import { createHash } from 'node:crypto'
    15	import { renderMermaidPNG, type PngFontWarning } from '../agent/png.ts'
    16	import { renderMermaidSVG } from '../index.ts'
    17	import { runCli } from '../cli/index.ts'
    18	import { PNG_NAPI_RUNTIME, PNG_WASM_RUNTIME, pngNapiRuntimeProvenance } from '../png-contract.ts'
    19	import { decodePng, inkColumns } from './helpers/png-pixels.ts'
    20	import { useTempDirs } from './helpers/temp-dir.ts'
    21	
    22	const temp = useTempDirs()
    23	
    24	const JOURNEY_LONG_LABEL = `journey
    25	  title Onboarding
    26	  section Signup
    27	    Complete the extremely long registration questionnaire form: 3: User
    28	`
    29	
    30	describe('PNG font provenance', () => {
    31	  test('distinguishes verified, caller-directory, system, and buffer inputs', () => {
    32	    expect(PNG_NAPI_RUNTIME.fontSources).toEqual(['verified-files'])
    33	    expect(PNG_WASM_RUNTIME.fontSources).toEqual(['verified-buffers'])
    34	    expect(PNG_NAPI_RUNTIME.reproducibility).toBe('content-addressed')
    35	    expect(PNG_WASM_RUNTIME.reproducibility).toBe('content-addressed')
    36	    expect(pngNapiRuntimeProvenance({ callerDirectories: ['/host/fonts'] }).fontSources)
    37	      .toEqual(['verified-files', 'caller-directories'])
    38	    expect(pngNapiRuntimeProvenance({ callerDirectories: ['/host/fonts'] }).reproducibility)
    39	      .toBe('host-dependent')
    40	    expect(pngNapiRuntimeProvenance({ loadSystemFonts: true }).fontSources)
    41	      .toEqual(['verified-files', 'system-fonts'])
    42	    expect(pngNapiRuntimeProvenance({ callerDirectories: ['/host/fonts'], loadSystemFonts: true }).fontSources)
    43	      .toEqual(['verified-files', 'caller-directories', 'system-fonts'])
    44	  })
    45	})
    46	
    47	/** The journey task box rect carries explicit geometry in the SVG output. */
    48	function taskBox(svg: string): { x: number; y: number; w: number; h: number } {
    49	  const m = svg.match(/<rect class="journey-task-box" x="([\d.]+)" y="([\d.]+)" width="([\d.]+)" height="([\d.]+)"/)
    50	  if (!m) throw new Error('journey-task-box rect not found in SVG output')
    51	  return { x: Number(m[1]), y: Number(m[2]), w: Number(m[3]), h: Number(m[4]) }
    52	}
    53	
    54	describe('PNG raster font matches the metrics font', () => {
    55	  test('long journey task label rasterizes inside its measured task box', () => {
    56	    // Same geometry as the PNG path (embedFontImport only toggles CSS).
    57	    const svg = renderMermaidSVG(JOURNEY_LONG_LABEL, { embedFontImport: false })
    58	    const box = taskBox(svg)
    59	
    60	    const scale = 2
    61	    const img = decodePng(renderMermaidPNG(JOURNEY_LONG_LABEL, { scale }))
    62	
    63	    // Scan strictly right of the box (3 CSS px of slack for the border stroke
    64	    // and its antialiasing), within the box's rows. The actor legend sits LEFT
    65	    // of the box, so only the right side is unambiguous.
    66	    const pad = 3 * scale
    67	    const overflow = inkColumns(
    68	      img,
    69	      (box.x + box.w) * scale + pad,
    70	      img.width,
    71	      box.y * scale + pad,
    72	      (box.y + box.h) * scale - pad,
    73	    )
    74	    expect({ overflowColumns: overflow.length, firstColumns: overflow.slice(0, 5) })
    75	      .toEqual({ overflowColumns: 0, firstColumns: [] })
    76	  })
    77	})
    78	
    79	// ---------------------------------------------------------------------------
    80	// Glyph-coverage warnings — CJK/emoji must be loud, never silent tofu.
    81	// ---------------------------------------------------------------------------
    82	
    83	const CJK_SRC = 'flowchart LR\n  A[日本語のラベル] --> B[漢字]'
    84	const EMOJI_SRC = 'flowchart LR\n  A[🚀 Launch] --> B[Done]'
    85	
    86	// CI installs WenQuanYi; local hosts may select another CJK-capable font directory.
    87	const CJK_FONT_DIR = process.env.AM_CJK_FONT_DIR ?? '/usr/share/fonts/truetype/wqy'
    88	const HAS_CJK_FONT = existsSync(CJK_FONT_DIR)
    89	if (process.env.CI === 'true' && !HAS_CJK_FONT) throw new Error('CI requires a CJK font: install fonts-wqy-zenhei or set AM_CJK_FONT_DIR')
    90	
    91	function collectWarnings(source: string, opts: Parameters<typeof renderMermaidPNG>[1] = {}): { png: Uint8Array; warnings: PngFontWarning[] } {
    92	  const warnings: PngFontWarning[] = []
    93	  const png = renderMermaidPNG(source, { ...opts, onWarning: w => { if (w.code === 'PNG_FONT_COVERAGE') warnings.push(w) } })
    94	  return { png, warnings }
    95	}
    96	
    97	describe('PNG glyph-coverage warnings', () => {
    98	  test('CJK text without a covering font warns, naming the script and the escape hatch', () => {
    99	    const { png, warnings } = collectWarnings(CJK_SRC)
   100	    expect(png.length).toBeGreaterThan(100)
   101	    const cjk = warnings.find(w => w.script === 'CJK')
   102	    expect(cjk?.code).toBe('PNG_FONT_COVERAGE')
   103	    expect(cjk?.chars).toContain('日')
   104	    expect(cjk?.message).toContain('CJK')
   105	    expect(cjk?.message).toContain('--font-dirs')
   106	    expect(cjk?.message).toContain('fontDirs')
   107	  })
   108	
   109	  test('uncovered emoji warns with the emoji script bucket', () => {
   110	    const { warnings } = collectWarnings(EMOJI_SRC)
   111	    const emoji = warnings.find(w => w.script === 'emoji')
   112	    expect(emoji?.code).toBe('PNG_FONT_COVERAGE')
   113	    expect(emoji?.chars).toContain('🚀')
   114	  })
   115	
   116	  test('Latin labels plus DejaVu-covered symbols produce no warning', () => {
   117	    // ∮ is missing from Inter but present in bundled DejaVu Sans — the
   118	    // coverage check must honor the whole bundled fallback chain.
   119	    const { warnings } = collectWarnings('flowchart LR\n  A[Contour ∮ integral] --> B[plain]')
   120	    expect(warnings).toEqual([])
   121	  })
   122	
   123	  test('loadSystemFonts: true keeps a qualified known-font warning', () => {
   124	    const { png, warnings } = collectWarnings(CJK_SRC, { loadSystemFonts: true })
   125	    expect(png.length).toBeGreaterThan(100)
   126	    expect(warnings.some(w => w.script === 'CJK')).toBe(true)
   127	    expect(warnings[0]!.message).toContain('installed system font may cover')
   128	    expect(warnings[0]!.message).not.toContain('will draw as')
   129	  })
   130	
   131	  test('warnings are deterministic across identical renders', () => {
   132	    const a = collectWarnings(CJK_SRC)
   133	    const b = collectWarnings(CJK_SRC)
   134	    expect(a.warnings).toEqual(b.warnings)
   135	    const hash = (png: Uint8Array) => createHash('sha256').update(png).digest('hex')
   136	    expect(hash(a.png)).toBe(hash(b.png))
   137	  })
   138	})
   139	
   140	describe('fontDirs escape hatch', () => {
   141	  test.skipIf(!HAS_CJK_FONT)('a CJK-capable fontDirs clears the warning and changes the rendered bytes', () => {
   142	    const bare = collectWarnings(CJK_SRC)
   143	    const withFonts = collectWarnings(CJK_SRC, { fontDirs: [CJK_FONT_DIR] })
   144	    expect(withFonts.warnings.filter(w => w.script === 'CJK')).toEqual([])
   145	    // Real glyphs instead of tofu — the extra directory reached the rasterizer.
   146	    expect(Buffer.compare(Buffer.from(bare.png), Buffer.from(withFonts.png))).not.toBe(0)
   147	  })
   148	})
   149	
   150	// ---------------------------------------------------------------------------
   151	// CLI plumbing: --font-dirs / --system-fonts and the stderr warning channel.
   152	// ---------------------------------------------------------------------------
   153	
   154	function captureCli(argv: string[]): { code: number; out: string; err: string } {
   155	  const outChunks: string[] = []
   156	  const errChunks: string[] = []
   157	  const origOut = process.stdout.write.bind(process.stdout)
   158	  const origErr = process.stderr.write.bind(process.stderr)
   159	  // eslint-disable-next-line @typescript-eslint/no-explicit-any
   160	  ;(process.stdout as any).write = (s: unknown) => { outChunks.push(String(s)); return true }
   161	  // eslint-disable-next-line @typescript-eslint/no-explicit-any
   162	  ;(process.stderr as any).write = (s: unknown) => { errChunks.push(String(s)); return true }
   163	  let code: number
   164	  try {
   165	    const result = runCli(argv)
   166	    if (typeof result !== 'number') throw new Error('Expected a synchronous command')
   167	    code = result
   168	  } finally {
   169	    // eslint-disable-next-line @typescript-eslint/no-explicit-any
   170	    ;(process.stdout as any).write = origOut
   171	    // eslint-disable-next-line @typescript-eslint/no-explicit-any
   172	    ;(process.stderr as any).write = origErr
   173	  }
   174	  return { code, out: outChunks.join(''), err: errChunks.join('') }
   175	}
   176	
   177	function tmpPngRun(source: string, extraFlags: string[] = []): { code: number; out: string; err: string; outFile: string } {
   178	  const dir = temp.dir('am-png-fonts-')
   179	  const inFile = join(dir, 'in.mmd')
   180	  const outFile = join(dir, 'out.png')
   181	  writeFileSync(inFile, source)
   182	  const r = captureCli(['render', inFile, '--format', 'png', '--output', outFile, ...extraFlags])
   183	  return { ...r, outFile }
   184	}
   185	
   186	describe('am render --format png font flags', () => {
   187	  test('PNG-only controls are rejected for non-PNG formats', () => {
   188	    const dir = temp.dir('am-png-only-flags-')
   189	    const input = join(dir, 'in.mmd')
   190	    writeFileSync(input, 'flowchart LR\n  A --> B')
   191	    for (const flag of [['--scale', '2'], ['--bg', '#fff'], ['--fit-width', '64'], ['--system-fonts']]) {
   192	      const { code, err } = captureCli(['render', input, '--format', 'svg', ...flag])
   193	      expect(code).toBe(2)
   194	      expect(err).toContain('valid only with --format png')
   195	    }
   196	  })
   197	
   198	  test('fit dimensions are integer pixels', () => {
   199	    const { code, err } = tmpPngRun('flowchart LR\n  A --> B', ['--fit-width', '96.5'])
   200	    expect(code).toBe(2)
   201	    expect(err).toContain('positive integer pixel value')
   202	  })
   203	
   204	  test('CJK render warns on stderr and reports warnings in the --json envelope', () => {
   205	    const { code, out, err, outFile } = tmpPngRun(CJK_SRC, ['--json'])
   206	    expect(code).toBe(0)
   207	    expect(existsSync(outFile)).toBe(true)
   208	    expect(err).toContain('PNG_FONT_COVERAGE')
   209	    expect(err).toContain('--font-dirs')
   210	    const payload = JSON.parse(out) as { ok: boolean; warnings: PngFontWarning[] }
   211	    expect(payload.ok).toBe(true)
   212	    expect(payload.warnings.map(w => w.script)).toContain('CJK')
   213	  })
   214	
   215	  test('pure-Latin render prints no coverage warning', () => {
   216	    const { code, err } = tmpPngRun('flowchart LR\n  A --> B')
   217	    expect(code).toBe(0)
   218	    expect(err).not.toContain('PNG_FONT_COVERAGE')
   219	  })
   220	
   221	  test.skipIf(!HAS_CJK_FONT)('--font-dirs silences the CJK warning', () => {
   222	    const { code, err, outFile } = tmpPngRun(CJK_SRC, ['--font-dirs', CJK_FONT_DIR])
   223	    expect(code).toBe(0)
   224	    expect(err).not.toContain('PNG_FONT_COVERAGE')
   225	    expect(readFileSync(outFile).length).toBeGreaterThan(100)
   226	  })
   227	
   228	  test('--system-fonts keeps a qualified bundled-font coverage warning', () => {
   229	    const { code, err, outFile } = tmpPngRun(CJK_SRC, ['--system-fonts'])
   230	    expect(code).toBe(0)
   231	    expect(err).toContain('PNG_FONT_COVERAGE')
   232	    expect(err).toContain('installed system font may cover')
   233	    expect(readFileSync(outFile).length).toBeGreaterThan(100)
   234	  })
   235	})
     1	name: Unit coverage diagnostic
     2	
     3	# Coverage locates under-tested source; behavioral assertions remain in CI.
     4	# Instrumentation is expensive on the corpus/property suites, so collect it
     5	# weekly and on demand rather than slowing every pull request.
     6	on:
     7	  schedule:
     8	    - cron: '37 4 * * 1'
     9	  workflow_dispatch:
    10	
    11	permissions:
    12	  contents: read
    13	
    14	concurrency:
    15	  group: coverage-diagnostic
    16	  cancel-in-progress: false
    17	
    18	jobs:
    19	  unit:
    20	    runs-on: ubuntu-latest
    21	    timeout-minutes: 20
    22	    strategy:
    23	      fail-fast: false
    24	      matrix:
    25	        shard: [1/3, 2/3, 3/3]
    26	    steps:
    27	      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
    28	      - uses: oven-sh/setup-bun@0c5077e51419868618aeaa5fe8019c62421857d6 # v2
    29	        with:
    30	          bun-version: 1.4.4
    31	          no-cache: true
    32	      - run: bun install --frozen-lockfile
    33	      - name: Build the Node bundle for cross-runtime contracts
    34	        run: bunx --no-install tsup
    35	      - name: Run covered unit shard
    36	        run: bun run test:coverage -- --shard=${{ matrix.shard }} --parallel=2
    37	      - name: Upload shard coverage
    38	        if: ${{ always() }}
    39	        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7
    40	        with:
    41	          name: unit-coverage-${{ strategy.job-index }}
    42	          path: coverage/lcov.info
    43	          if-no-files-found: warn
    44	          retention-days: 7
    45	
    46	  merge:
    47	    needs: unit
    48	    runs-on: ubuntu-latest
    49	    timeout-minutes: 5
    50	    steps:
    51	      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
    52	      - uses: oven-sh/setup-bun@0c5077e51419868618aeaa5fe8019c62421857d6 # v2
    53	        with:
    54	          bun-version: 1.4.4
    55	          no-cache: true
    56	      - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8
    57	        with:
    58	          pattern: unit-coverage-*
    59	          path: coverage-shards
    60	      - run: bun run scripts/ci/merge-lcov.ts coverage-shards coverage/lcov.info 3
    61	      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7
    62	        with:
    63	          name: coverage-lcov
    64	          path: coverage/lcov.info
    65	          if-no-files-found: error
    66	          retention-days: 7
