    37	// The official upstream docs example (also eval corpus/quadrant/2).
    38	const STYLED = `quadrantChart
    39	  title Reach and engagement of campaigns
    40	  x-axis Low Reach --> High Reach
    41	  y-axis Low Engagement --> High Engagement
    42	  quadrant-1 We should expand
    43	  quadrant-2 Need to promote
    44	  quadrant-3 Re-evaluate
    45	  quadrant-4 May be improved
    46	  Campaign A: [0.9, 0.0] radius: 12
    47	  Campaign B:::class1: [0.8, 0.1] color: #ff3300, radius: 10
    48	  Campaign C: [0.7, 0.2] radius: 25, color: #00ff33, stroke-color: #10f0f0
    49	  Campaign D: [0.6, 0.3] radius: 15, stroke-color: #00ff0f, stroke-width: 5px ,color: #ff33f0
    50	  Campaign E:::class2: [0.5, 0.4]
    51	  Campaign F:::class3: [0.4, 0.5] color: #0000ff
    52	  classDef class1 color: #109060
    53	  classDef class2 color: #908342, radius : 10, stroke-color: #310085, stroke-width: 10px
    54	  classDef class3 color: #f00fff, radius : 10
    55	`
    56	
    57	// ---------------------------------------------------------------------------
    58	// Parser — styles and classes are modeled, not discarded
    59	// ---------------------------------------------------------------------------
    60	
    61	describe('quadrant parser models point styles and classDefs', () => {
    62	  const chart = parse(STYLED)
    63	
    64	  it('keeps commas inside functional colors while splitting top-level entries', () => {
    65	    const chart = parse(`quadrantChart
    66	  RGB: [0.2, 0.8] color: rgb(255, 0, 0), radius: 10, stroke-color: hsl(120, 100%, 50%)
    67	  classDef mixed color: rgba(10, 20, 30, 0.5)
    68	  Mixed:::mixed: [0.8, 0.2]`)
    69	    expect(chart.points[0]!.style).toMatchObject({ color: 'rgb(255, 0, 0)', radius: 10, strokeColor: 'hsl(120, 100%, 50%)' })
    70	    expect(chart.classDefs.mixed!.color).toBe('rgba(10, 20, 30, 0.5)')
    71	    const svg = renderMermaidSVG(`quadrantChart
    72	  RGB: [0.2, 0.8] color: rgb(255, 0, 0), radius: 10`)
    73	    expect(svg).toContain('fill="rgb(255, 0, 0)"')
    74	  })
    75	
    76	  it('rejects unbalanced color functions loudly', () => {
    77	    expect(() => parse('quadrantChart\n  Broken: [0.2, 0.8] color: rgb(1, 2, 3')).toThrow('unbalanced parentheses')
    78	  })
    79	
    80	  it('parses direct point styles into typed fields', () => {
    81	    const byLabel = (l: string) => chart.points.find(p => p.label === l)!
    82	    expect(byLabel('Campaign A').style).toEqual({ radius: 12 })
    83	    expect(byLabel('Campaign B').style).toEqual({ color: '#ff3300', radius: 10 })
    84	    expect(byLabel('Campaign C').style).toEqual({ radius: 25, color: '#00ff33', strokeColor: '#10f0f0' })
    85	    expect(byLabel('Campaign D').style).toEqual({ radius: 15, strokeColor: '#00ff0f', strokeWidth: '5px', color: '#ff33f0' })
    86	    expect(byLabel('Campaign E').style).toBeUndefined()
    87	  })
    88	
    89	  it('parses ::: class assignments into className', () => {
    90	    const byLabel = (l: string) => chart.points.find(p => p.label === l)!
    91	    expect(byLabel('Campaign B').className).toBe('class1')
    92	    expect(byLabel('Campaign E').className).toBe('class2')
    93	    expect(byLabel('Campaign F').className).toBe('class3')
    94	    expect(byLabel('Campaign A').className).toBeUndefined()
    95	  })
    96	
    97	  it('parses classDef lines into the classDefs table (space before colon tolerated)', () => {
    98	    expect(chart.classDefs['class1']).toEqual({ color: '#109060' })
    99	    expect(chart.classDefs['class2']).toEqual({ color: '#908342', radius: 10, strokeColor: '#310085', strokeWidth: '10px' })
   100	    expect(chart.classDefs['class3']).toEqual({ color: '#f00fff', radius: 10 })
   101	  })
   102	
   103	  it('keeps the loud-error contract for malformed style metadata', () => {
   104	    // Known keys validate their values; unsafe values error. Safe unknown
   105	    // properties remain a readable native extension and stay source-only.
   106	    expect(() => parse('quadrantChart\n  A: [0.5, 0.5] radius: big')).toThrow(/radius/i)
   107	    expect(() => parse('quadrantChart\n  A: [0.5, 0.5] banana: "spl;it"')).toThrow(/style/i)
   108	    expect(() => parse('quadrantChart\n  A: [0.5, 0.5] color: "x;{}"')).toThrow(/color|style/i)
   109	  })
   110	})
   111	
   112	describe('quadrant authored paint admission (#303)', () => {
   113	  const invalid = ['notacolor', '#12345', 'rgb(x)', 'url(#a)', 'color-mix(in srgb, red 20%, blue)']
   114	
   115	  it('refuses every non-drawable direct and class paint before graphical or terminal output', () => {
   116	    for (const property of ['color', 'stroke-color'] as const) {
   117	      for (const value of invalid) {
   118	        for (const source of [
   119	          `quadrantChart\n  A: [0.5, 0.5] ${property}: ${value}`,
   120	          `quadrantChart\n  classDef bad ${property}: ${value}\n  A:::bad: [0.5, 0.5]`,
   121	        ]) {
   122	          const named = `${property} ${JSON.stringify(value)} is not a CSS color`
   123	          expect(() => renderMermaidSVG(source), source).toThrow(named)
   124	          expect(() => renderMermaidPNG(source), source).toThrow(named)
   125	          expect(() => renderMermaidASCII(source, { useAscii: true }), source).toThrow(named)
   126	          expect(() => renderMermaidASCII(source, { useAscii: false }), source).toThrow(named)
   127	          const agent = parseMermaid(source)
   128	          expect(agent.ok).toBe(true)
   129	          if (agent.ok) expect(agent.value.body.kind).toBe('opaque')
   130	          const verdict = verifyMermaid(source)
   131	          expect(verdict.ok).toBe(false)
   132	          expect(verdict.warnings).toContainEqual({ code: 'RENDER_FAILED', reason: expect.stringContaining(named), origin: 'source' })
   133	        }
   134	      }
   135	    }
   136	  })
   137	
   138	  it('preserves drawable fill and stroke paints, including none and unresolved local variables', () => {
   139	    for (const value of ['rebeccapurple', '#f96', '#11223380', 'rgb(255, 0, 0)', 'hsl(120 100% 50%)', 'transparent', 'currentColor', 'none', 'var(--brand)']) {
   140	      const source = `quadrantChart\n  A: [0.5, 0.5] color: ${value}, stroke-color: ${value}`
   141	      expect(() => renderMermaidSVG(source), value).not.toThrow()
   142	      expect(() => renderMermaidASCII(source), value).not.toThrow()
   143	      expect(verifyMermaid(source).warnings.filter(w => w.code === 'RENDER_FAILED' || w.code === 'INTERNAL_ERROR')).toEqual([])
   144	    }
   145	  })
   146	
   147	  it('projects only nominal bounded color errors through CLI and MCP', async () => {
   148	    const source = 'quadrantChart\n  A: [0.5, 0.5] color: notacolor'
   149	    for (const format of ['svg', 'ascii', 'unicode'] as const) {
   150	      const result = runBatchLine(JSON.stringify({ op: 'render', format, source }), 0) as { ok: boolean; error: { code: string; subject: string; property: string; value: string; message: string } }
   151	      expect(result).toMatchObject({ ok: false, error: { code: 'INVALID_STYLE_COLOR', subject: 'quadrant point A', property: 'color', value: 'notacolor', message: expect.stringContaining('notacolor') } })
   152	    }
   153	    const response = await handleHostedRequest(
   154	      { jsonrpc: '2.0', id: 1, method: 'tools/call', params: { name: 'render_svg', arguments: { source } } },
   155	      {
   156	        async execute() { return { ok: true, value: null, logs: [] } },
   157	        async renderPng() { throw new Error('not used') },
   158	      },
   159	    )
   160	    const payload = JSON.parse((response?.result as { content: Array<{ text: string }> }).content[0]!.text)
   161	    expect(payload).toMatchObject({ ok: false, error: { code: 'INVALID_STYLE_COLOR', property: 'color', value: 'notacolor' } })
   162	    expect(projectRenderErrorDiagnostic({ code: 'INVALID_STYLE_COLOR', subject: 'quadrant point A', property: 'color', value: 'notacolor', message: 'forged' }))
   163	      .toEqual({ code: 'RENDER_FAILED', message: 'Rendering failed' })
   164	    const veryLong = 'x'.repeat(100_000)
   165	    let thrown: unknown
   166	    try { renderMermaidSVG(`quadrantChart\n  A: [0.5, 0.5] color: ${veryLong}`) } catch (error) { thrown = error }
   167	    expect(thrown).toBeInstanceOf(QuadrantStyleColorError)
   168	    const diagnostic = projectRenderErrorDiagnostic(thrown)
   169	    expect(diagnostic.message.length).toBeLessThan(600)
   170	    expect('value' in diagnostic && diagnostic.value.length).toBeLessThanOrEqual(256)
   171	  })
   172	})
