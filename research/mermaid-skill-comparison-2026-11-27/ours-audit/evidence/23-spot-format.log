     4	import { renderMermaidSVGAsync } from '../browser-lazy.ts'
     5	import { buildMermaid, parseRegisteredMermaid, serializeMermaid, verifyMermaid } from '../agent/index.ts'
     6	import { renderMermaidPNG } from '../agent/png.ts'
     7	import { runBatchLine } from '../cli/index.ts'
