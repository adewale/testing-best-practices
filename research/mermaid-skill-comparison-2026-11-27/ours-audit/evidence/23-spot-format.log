   174	// ---------------------------------------------------------------------------
   175	// Resolution — ONE place, precedence direct > class > default
   176	// ---------------------------------------------------------------------------
   177	
   178	describe('quadrant point style resolution', () => {
   179	  const chart = parse(STYLED)
   180	  const defaults = { radius: 6 }
   181	
   182	  it('direct styles win over class styles which win over defaults', () => {
   183	    const b = chart.points.find(p => p.label === 'Campaign B')!
   184	    const rb = resolvePointVisual(b, chart.classDefs, defaults)
   185	    expect(rb.fill).toBe('#ff3300') // direct beats classDef class1 color #109060
   186	    expect(rb.radius).toBe(10)
   187	
   188	    const f = chart.points.find(p => p.label === 'Campaign F')!
   189	    const rf = resolvePointVisual(f, chart.classDefs, defaults)
   190	    expect(rf.fill).toBe('#0000ff')  // direct color
   191	    expect(rf.radius).toBe(10)       // class radius fills the gap
   192	
   193	    const e = chart.points.find(p => p.label === 'Campaign E')!
   194	    const re = resolvePointVisual(e, chart.classDefs, defaults)
   195	    expect(re).toMatchObject({ fill: '#908342', radius: 10, stroke: '#310085', strokeWidth: '10px' })
   196	  })
   197	
   198	  it('a point referencing an unknown class resolves to defaults (upstream parity)', () => {
   199	    const chart2 = parse('quadrantChart\n  P:::ghost: [0.5, 0.5]')
   200	    const r = resolvePointVisual(chart2.points[0]!, chart2.classDefs, defaults)
   201	    expect(r.radius).toBe(6)
   202	    expect(r.fill).toBeUndefined()
   203	  })
   204	})
   205	
   206	// ---------------------------------------------------------------------------
   207	// Layout — resolved radius drives geometry
   208	// ---------------------------------------------------------------------------
   209	
   210	describe('quadrant layout consumes resolved point styles', () => {
   211	  it('positioned radius follows direct/class radius', () => {
   212	    const positioned = layoutQuadrantChart(parse(STYLED))
   213	    const byLabel = (l: string) => positioned.points.find(p => p.label === l)!
   214	    expect(byLabel('Campaign A').radius).toBe(12)
   215	    expect(byLabel('Campaign C').radius).toBe(25)
   216	    expect(byLabel('Campaign E').radius).toBe(10)
   217	  })
   218	
   219	  it('unstyled points keep the default radius', () => {
   220	    const positioned = layoutQuadrantChart(parse('quadrantChart\n  P: [0.5, 0.5]'))
   221	    expect(positioned.points[0]!.radius).toBe(6)
   222	  })
   223	})
