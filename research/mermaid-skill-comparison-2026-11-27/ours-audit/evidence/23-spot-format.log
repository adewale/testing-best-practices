     9	import { projectRenderErrorDiagnostic } from '../render-error-diagnostic.ts'
    10	import { drawableAuthoredCssPaint } from '../shared/css-color.ts'
    11	import { tryParseCssColor } from '../shared/color-math.ts'
    12	
    13	const INVALID = [
    14	  'notacolor', 'constructor', '__proto__', 'rgb(x)', 'rgb(1oops,2,3)',
    15	  'rgba(1,2,3,0.5junk)', 'hsl(120,50%oops,50%)', '#12345',
    16	  'rgb(1 2 3 / .5 / junk)', 'hsl(120 50% 50% / .5 / junk)',
    17	  'rgb(1 2 3 .5)', 'hsl(120 50% 50% .5)',
    18	  'rgb(1,20%,3)', 'rgba(1,20%,3,.5)',
    19	  'rgb(1. 2 3)', 'rgb(1.e2 2 3)', 'hsl(120. 50% 50%)',
    20	  'rgb(1, 2, 3 / .5)', 'hsl(120, 50%, 50% / .5)',
    21	  'hsl(1e308turn,50%,50%)',
    22	  'hwb(120 0% 0%)', 'color-mix(in srgb, red, blue)', 'url(#a)',
    23	] as const
    24	
    25	const SOURCES = [
    26	  { directive: 'style A', make: (value: string) => `flowchart TD\n  A --> B\n  style A fill:${value}` },
    27	  { directive: 'classDef hot', make: (value: string) => `flowchart TD\n  A:::hot --> B\n  classDef hot fill:${value}` },
    28	  { directive: 'linkStyle 0', make: (value: string) => `flowchart TD\n  A --> B\n  linkStyle 0 stroke:${value}` },
    29	  { directive: 'classDef hot', make: (value: string) => `stateDiagram-v2\n  A --> B\n  classDef hot fill:${value}\n  class A hot` },
    30	  { directive: 'style A', make: (value: string) => `classDiagram\n  class A\n  style A fill:${value}` },
    31	  { directive: 'style A', make: (value: string) => `erDiagram\n  A ||--o{ B : has\n  style A fill:${value}` },
    32	] as const
    33	
    34	describe('authored style color admission (#303, source/typed slice)', () => {
    35	  test('distinguishes real colors from safe-looking words and malformed functions', () => {
    36	    for (const value of INVALID) expect(drawableAuthoredCssPaint(value), value).toBeUndefined()
    37	    for (const value of ['red', '#f96', '#3b82', '#112233', '#11223380', 'rgb(1,2,3)', 'rgba(1,2,3,.5)', 'rgb(300,0,0)', 'rgb(-1 0 0)', 'rgba(255,0,0,2)', 'hsl(120,50%,50%)', 'hsl(120 100 50)', 'hsl(120 150% 50%)', 'hsl(120 100% 150%)', 'transparent', 'currentColor', 'var(--brand)']) {
    38	      expect(drawableAuthoredCssPaint(value), value).toBe(value)
    39	    }
    40	    expect(tryParseCssColor('rgb(300,0,0)')).toEqual([255, 0, 0, 1])
    41	    expect(tryParseCssColor('rgba(255,0,0,2)')).toEqual([255, 0, 0, 1])
    42	    expect(tryParseCssColor('hsl(120 100 50)')).toEqual([0, 255, 0, 1])
    43	    for (const value of ['rgb(300,0,0)', 'rgba(255,0,0,2)', 'hsl(120 100 50)', 'hsl(120 150% 50%)']) {
    44	      expect(() => renderMermaidSVG(SOURCES[0]!.make(value)), value).not.toThrow()
    45	    }
    46	    expect(drawableAuthoredCssPaint('none', true)).toBe('none')
    47	    expect(drawableAuthoredCssPaint('none', false)).toBeUndefined()
    48	    expect(tryParseCssColor('constructor')).toBeNull()
    49	    expect(tryParseCssColor('rgb(1oops,2,3)')).toBeNull()
    50	    expect(tryParseCssColor('rgb(1 2 3 / .5 / junk)')).toBeNull()
    51	    expect(tryParseCssColor('hsl(120 50% 50% / .5 / junk)')).toBeNull()
    52	    expect(tryParseCssColor('hsl(1e308turn,50%,50%)')).toBeNull()
    53	    expect(tryParseCssColor('rgb(1,20%,3)')).toBeNull()
    54	    expect(tryParseCssColor('#3b82')).toEqual([0x33, 0xbb, 0x88, 0x22 / 255])
    55	  })
    56	
    57	  test('every affected graphical source placement refuses the offending value by directive and property', () => {
    58	    for (const { directive, make } of SOURCES) {
    59	      for (const value of INVALID) {
    60	        const source = make(value)
    61	        const named = `${directive}: ${directive.startsWith('linkStyle') ? 'stroke' : 'fill'} ${JSON.stringify(value)} is not a CSS color`
    62	        expect(() => renderMermaidSVG(source)).toThrow(named)
    63	        expect(() => renderMermaidASCII(source, { useAscii: true })).toThrow(named)
    64	        expect(() => renderMermaidASCII(source, { useAscii: false })).toThrow(named)
    65	      }
    66	    }
    67	  })
    68	
    69	  test('verify exposes the same reason, and PNG refuses before drawing a misleading node', () => {
    70	    const source = SOURCES[0]!.make('notacolor')
    71	    expect(verifyMermaid(source).warnings).toEqual([
    72	      { code: 'RENDER_FAILED', reason: expect.stringContaining('style A: fill "notacolor" is not a CSS color'), origin: 'source' },
    73	    ])
    74	    expect(() => renderMermaidPNG(source)).toThrow('style A: fill "notacolor" is not a CSS color')
    75	    for (const colorMode of ['none', 'ansi16', 'ansi256', 'truecolor', 'html'] as const) {
    76	      expect(() => renderMermaidASCII(source, { colorMode })).toThrow('style A: fill "notacolor" is not a CSS color')
    77	    }
    78	  })
    79	
    80	  test('unused declarations cannot hide invalid colors from render or verify', () => {
    81	    for (const [source, named] of [
    82	      ['flowchart TD\n  A --> B\n  classDef unused fill:notacolor', 'classDef unused: fill "notacolor"'],
    83	      ['flowchart TD\n  A --> B\n  style Z fill:notacolor', 'style Z: fill "notacolor"'],
    84	      ['flowchart TD\n  A --> B\n  linkStyle 99 stroke:notacolor', 'linkStyle 99: stroke "notacolor"'],
    85	      ['stateDiagram-v2\n  A --> B\n  classDef unused fill:notacolor', 'classDef unused: fill "notacolor"'],
    86	      ['classDiagram\n  class A\n  classDef unused fill:notacolor', 'classDef unused: fill "notacolor"'],
    87	      ['erDiagram\n  A ||--o{ B : has\n  classDef unused fill:notacolor', 'classDef unused: fill "notacolor"'],
    88	    ] as const) {
    89	      expect(() => renderMermaidSVG(source), source).toThrow(named)
    90	      expect(() => renderMermaidASCII(source, { useAscii: true }), source).toThrow(named)
    91	      const result = verifyMermaid(source)
    92	      expect(result.ok, source).toBe(false)
    93	      expect(result.warnings.some(warning => warning.code === 'RENDER_FAILED' && warning.reason?.includes(named)), source).toBe(true)
    94	    }
    95	  })
    96	
    97	  // Mermaid draws a Class class's paint in statement order, and verify warns
    98	  // where that order makes it draw otherwise than ours; the writer orders
    99	  // classDefs before `style`. Neither admits paint: a refused value is refused
   100	  // by directive in either order and either position, the order warning
   101	  // compares only admitted paint and never names a value, and the writer
   102	  // only orders the lines it already writes, markup still entity-coded.
   103	  test('Class style and classDef order neither admits nor echoes refused paint', () => {
   104	    for (const value of ['notacolor', 'url(#a)', 'rgb(x)', '#f00</style><script>']) {
   105	      for (const [directive, lines] of [
   106	        ['style B', [`  style B fill:${value}`, '  classDef hot fill:#f96']],
   107	        ['style B', ['  classDef hot fill:#f96', `  style B fill:${value}`]],
   108	        ['classDef hot', ['  style B fill:#000', `  classDef hot fill:${value}`]],
   109	        ['classDef hot', [`  classDef hot fill:${value}`, '  style B fill:#000']],
   110	      ] as const) {
   111	        const source = ['classDiagram', '  class B:::hot', ...lines].join('\n')
   112	        const named = `${directive}: fill ${JSON.stringify(value)} is not a CSS color`
   113	        expect(() => renderMermaidSVG(source), source).toThrow(named)
   114	        expect(() => renderMermaidASCII(source, { useAscii: true }), source).toThrow(named)
   115	        const { warnings } = verifyMermaid(source)
   116	        expect(warnings.flatMap(warning => warning.code === 'UNSUPPORTED_SYNTAX' && (/^class_(style_before_classdef|classdef_order)$/.test(warning.syntax) || warning.message.includes(value)) ? [warning] : []), source).toEqual([])
   117	        expect(warnings.some(warning => warning.code === 'RENDER_FAILED' && warning.reason?.includes(named)), source).toBe(true)
   118	        const parsed = parseRegisteredMermaid(source)
   119	        if (!parsed.ok) throw new Error(source)
   120	        const written = serializeMermaid(parsed.value)
   121	        expect(written.split('\n').slice(1, 5).map(line => line.trim().split(/[\s:]+/, 2).join(' ')), source).toEqual(['class B', 'cssClass "B"', 'classDef hot', 'style B'])
