   226	// SVG — the rendered attributes match the resolution (invariant gate)
   227	// ---------------------------------------------------------------------------
   228	
   229	function circleFor(svg: string, label: string): string {
   230	  const m = svg.match(new RegExp(`<circle[^>]*data-label="${label}"[^>]*/>`))
   231	  expect(m).not.toBeNull()
   232	  return m![0]!
   233	}
   234	
   235	describe('quadrant SVG renders point styles', () => {
   236	  const svg = renderMermaidSVG(STYLED)
   237	
   238	  it('direct styles reach the circle (fill / radius / stroke)', () => {
   239	    const c = circleFor(svg, 'Campaign C')
   240	    expect(c).toContain('r="25"')
   241	    expect(c).toContain('fill="#00ff33"')
   242	    expect(c).toContain('stroke="#10f0f0"')
   243	    const d = circleFor(svg, 'Campaign D')
   244	    expect(d).toContain('stroke-width="5px"')
   245	  })
     1	import { describe, expect, test } from 'bun:test'
