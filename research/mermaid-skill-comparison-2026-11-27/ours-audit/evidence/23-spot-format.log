     1	// ============================================================================
     2	// Quadrant per-point styling + classDef — upstream contract (merged
     3	// mermaid-js/mermaid#5173, documented at mermaid.js.org/syntax/quadrantChart):
     4	//
     5	//   Direct styles on a point:   `Label: [x, y] radius: 12, color: #ff3300,
     6	//                                stroke-color: #10f0f0, stroke-width: 5px`
     7	//   Class definition:           `classDef class1 color: #109060`
     8	//   Class application:          `Label:::class1: [x, y]`
     9	//   Precedence:                 direct styles > class styles > theme defaults.
    10	//
    11	// Before this feature the parser validated and DISCARDED the styles, and any
    12	// `:::`/classDef knocked the agent body opaque. Now styles flow parser →
    13	// layout (one resolution site, src/quadrant/point-style.ts) → renderer, and
    14	// the agent body models them as typed, mutable content.
    15	// ============================================================================
    16	
    17	import { describe, it, expect } from 'bun:test'
    18	import { parseQuadrantChart } from '../quadrant/parser.ts'
    19	import { layoutQuadrantChart } from '../quadrant/layout.ts'
    20	import { QuadrantStyleColorError, resolvePointVisual } from '../quadrant/point-style.ts'
    21	import { renderMermaidASCII, renderMermaidSVG } from '../index.ts'
    22	import { toMermaidLines, normalizeMermaidSource } from '../mermaid-source.ts'
    23	import { parseRegisteredMermaid as parseMermaid } from '../agent/parse.ts'
    24	import { serializeMermaid } from '../agent/serialize.ts'
    25	import { mutate } from '../agent/mutate.ts'
    26	import { verifyMermaid } from '../agent/verify.ts'
    27	import { asQuadrant } from '../agent/types.ts'
    28	import { runBatchLine } from '../cli/index.ts'
    29	import { handleHostedRequest } from '../mcp/hosted-server.ts'
    30	import { projectRenderErrorDiagnostic } from '../render-error-diagnostic.ts'
    31	import { renderMermaidPNG } from '../agent/png.ts'
    32	
    33	function parse(src: string) {
    34	  return parseQuadrantChart(toMermaidLines(src))
    35	}
