    97	  raw: readonly PositionedEdge[],
    98	  edges: readonly PositionedEdge[],
    99	  nodeMap: ReadonlyMap<string, PositionedNode>,
   100	  groups: PositionedGroup[],
   101	  direction: Direction,
   102	  reaches: (from: string, to: string) => boolean,
   103	): PositionedEdge[] | undefined {
   104	  if (raw.length < 2 || raw.length > 3) return undefined
   105	  if (source.shape !== 'rectangle' && source.shape !== 'diamond') return undefined
   106	  const routeOnly = source.shape !== 'diamond' && nodeInsideGroups(source, groups)
   107	  const sorted = [...raw].sort((a, b) => nodeCrossCenter(nodeMap.get(a.target)!, direction) - nodeCrossCenter(nodeMap.get(b.target)!, direction))
   108	  const targets = sorted.map(e => nodeMap.get(e.target)!).filter(Boolean)
   109	  if (targets.length !== sorted.length) return undefined
   110	  const scope = routeOnly ? containingGroups(source, groups) : ''
   111	  // Grouped rectangle forks retain placement; diamond forks may propose new
   112	  // placement, subject to the enclosure checks in placementClear below.
   113	  if (!targets.every(t => t.shape === 'rectangle' && (routeOnly ? containingGroups(t, groups) === scope : source.shape === 'diamond' || !nodeInsideGroups(t, groups)))) return undefined
   114	  // Same-rank gate. Fan-out targets drift apart on the main axis when their
   115	  // label widths differ ("warnings" 97px vs "ok" 60px → ~32px apart), so the
   116	  // tolerance must clear that width-driven drift to see them as peers — while
   117	  // staying below layerSpacing (48) so genuinely different ranks are still
   118	  // rejected. The peer confirmation just below is the real safety net, so
   119	  // loosening this gate cannot equalize non-peers. (Equalizing such peers is
   120	  // exactly the symmetry the diamond/"warnings"/"ok" fan-out wants; verified
   121	  // byte-identical on the corpus, which has no fan-out in the 28–40px band.)
