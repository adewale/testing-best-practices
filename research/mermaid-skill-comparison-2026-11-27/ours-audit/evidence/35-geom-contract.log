   220	      clear = placementClear()
   221	    }
   222	    if (!clear) {
   223	      restoreGeometry()
   224	      continue
   225	    }
   226	
   227	    const sourceEdge = f.isHorizontal
   228	      ? (f.sourceSide === 'E' ? source.x + source.width : source.x)
