  1527	async function cmdBatch(): Promise<number> {
  1528	  if (process.stdin.isTTY) throw new CliArgumentError('needs a file argument or piped stdin')
  1529	  const { streamJsonlBatch } = await import('./jsonl.ts')
  1530	  await streamJsonlBatch(process.stdin, process.stdout, runBatchLine)
  1531	  // Per-line failures don't abort; input/output transport failures do.
  1532	  return EXIT_OK
