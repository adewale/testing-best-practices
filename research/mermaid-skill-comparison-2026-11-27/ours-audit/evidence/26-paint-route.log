  1535	function toJsonSafe(d: ParsedDiagram): unknown {
  1536	  if (d.body.kind === 'flowchart') {
  1537	    const g = d.body.graph
  1538	    return {
  1539	      kind: d.kind,
  1540	      meta: d.meta,
  1541	      body: {
  1542	        kind: 'flowchart',
  1543	        graph: {
  1544	          direction: g.direction,
  1545	          nodes: Object.fromEntries(g.nodes),
  1546	          edges: g.edges,
  1547	          subgraphs: g.subgraphs,
  1548	          // Preserve styling so `am parse | am serialize` is lossless.
  1549	          classDefs: Object.fromEntries(g.classDefs),
  1550	          classAssignments: Object.fromEntries(g.classAssignments),
  1551	          nodeStyles: Object.fromEntries(g.nodeStyles),
  1552	          linkStyles: Object.fromEntries([...g.linkStyles].map(([k, v]) => [String(k), v])),
  1553	        },
  1554	      },
  1555	      canonicalSource: d.canonicalSource,
  1556	    }
