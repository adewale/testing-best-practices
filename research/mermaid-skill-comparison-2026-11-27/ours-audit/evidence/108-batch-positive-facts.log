   179	  test('processes 5 lines with mixed validity and exits 0', () => {
   180	    const validRender = JSON.stringify({ op: 'render', source: 'flowchart LR\n  A --> B', options: { format: 'ascii' } })
   181	    const validVerify = JSON.stringify({ op: 'verify', source: 'flowchart LR\n  A --> B' })
   182	    const malformed = '{not valid json'
   183	    const unknownOp = JSON.stringify({ op: 'nope', source: 'x' })
   184	    // Large source > 10KB. Use long ASCII labels rather than many nodes so the
   185	    // layout engine doesn't blow the wallclock budget.
   186	    const longLabel = 'x'.repeat(200)
   187	    const big = JSON.stringify({ op: 'render', source: `flowchart LR\n  A["${longLabel}"] --> B["${longLabel}"]\n  B --> C["${longLabel}"]\n  C --> D["${longLabel}"]\n  D --> E["${longLabel}"]\n  E --> F["${longLabel}"]\n  F --> G["${longLabel}"]\n  G --> H["${longLabel}"]\n  H --> I["${longLabel}"]\n  I --> J["${longLabel}"]\n  J --> K["${longLabel}"]\n  K --> L["${longLabel}"]\n  L --> M["${longLabel}"]\n  M --> N["${longLabel}"]\n`, options: { format: 'ascii' } })
   188	    const stdin = [validRender, validVerify, malformed, unknownOp, big].join('\n') + '\n'
   189	
   190	    const { status, stdout } = runAm(['batch'], stdin)
   191	    expect(status).toBe(0)
   192	    const lines = stdout.trim().split('\n')
   193	    expect(lines.length).toBe(5)
   194	
   195	    const out = lines.map(l => JSON.parse(l))
   196	    expect(out[0].ok).toBe(true)
   197	    expect(out[0].op).toBe('render')
   198	    expect(typeof out[0].data.ascii).toBe('string')
   199	
   200	    expect(out[1].ok).toBe(true)
   201	    expect(out[1].op).toBe('verify')
   202	    expect(Array.isArray(out[1].data.warnings)).toBe(true)
   203	
   204	    expect(out[2].ok).toBe(false)
   205	    expect(out[2].error.code).toBe('INVALID_JSON')
   206	
   207	    expect(out[3].ok).toBe(false)
   208	    expect(out[3].error.code).toBe('UNKNOWN_OP')
