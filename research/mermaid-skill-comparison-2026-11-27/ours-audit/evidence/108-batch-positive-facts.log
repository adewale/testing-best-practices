   217	
   218	export const CLI_RENDER_FORMATS: readonly CliRenderFormat[] = /* @__PURE__ */ cliRenderFormats()
   219	
   220	function defaultCliRenderFormat(): CliRenderFormat {
   221	  const defaults = CLI_RENDER_OUTPUT_DESCRIPTORS.filter(descriptor => descriptor.transports.cli.default)
   222	  if (defaults.length !== 1) throw new Error('Render output contract must declare exactly one default CLI format')
   223	  return defaults[0]!.transports.cli.format as CliRenderFormat
   224	}
   225	
   226	export const DEFAULT_CLI_RENDER_FORMAT = /* @__PURE__ */ defaultCliRenderFormat()
   227	
   228	export function isCliRenderFormat(value: string): value is CliRenderFormat {
   229	  return CLI_RENDER_FORMATS.includes(value as CliRenderFormat)
