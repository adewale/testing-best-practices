211:    fc.assert(fc.property(wellFormedStringArb, (value) => {
     1	// Regression: fan-out peers with differing label widths must be equalized and
     2	// aligned (the "warnings"/"ok" symmetry).
     3	//
     4	// In `C -->|warnings| D["warnings"]` + `C -->|ok| E["ok"]`, D and E are genuine
     5	// fan-out peers of C. ELK places them at different widths (97 vs 60) AND
     6	// different main-axis positions (~32px apart, driven by that width gap), so they
     7	// look mismatched. applySymmetricFanoutEmissions exists to equalize such peers,
     8	// but its same-rank gate previously rejected any pair more than 28px apart —
     9	// tighter than the very width-driven drift it was meant to absorb — so it bailed
    10	// and the asymmetry stood. Widening that gate to 40 (still below layerSpacing,
    11	// and AFTER the peer confirmation, so non-peers are never affected) lets the pass
    12	// equalize them. Reverting the gate to 28 fails the assertions below.
    13	
    14	import { describe, test, expect } from 'bun:test'
    15	import { parseRegisteredMermaid as parseMermaid, layoutMermaid } from '../agent/index.ts'
    16	import { parseMermaid as parseGraph } from '../parser.ts'
    17	import { layoutGraphSync } from '../layout-engine.ts'
    18	import { layoutFlow } from '../layout/geometry.ts'
    19	import { doglegBetween, sourceEmissionPort, targetFlowPort } from '../layout/passes/shared.ts'
    20	import { bundleEdgePaths } from '../layout/passes/edge-bundling.ts'
    21	import { applySymmetricFanoutEmissions } from '../layout/passes/fanout.ts'
    22	import { resolveRenderStyle } from '../styles.ts'
    23	import { renderMermaidSVG } from '../index.ts'
    24	
    25	const SYM = [
    26	  'flowchart LR',
    27	  '  A["warnings"] -->|warnings| B["ok"]',
    28	  '  B -->|ok| C["rendered"]',
    29	  '  A2["same word: warnings"] --> A',
    30	  '  B2["same word: ok"] --> B',
    31	  '  C -->|warnings| D["warnings"]',
    32	  '  C -->|ok| E["ok"]',
    33	].join('\n')
    34	
    35	describe('fan-out peer symmetry', () => {
    36	  for (const direction of ['TD', 'LR']) test(`grouped diamond targets keep their authored containment (${direction})`, () => {
    37	    const source = `flowchart ${direction}
    38	A[Christmas] -->|Get money| B(Go shopping)
    39	B --> C{Let me think}
    40	B --> G[/Another/]
    41	C ==>|One| D[Laptop]
    42	C -->|Two| E[iPhone]
    43	C -->|Three| F[fa:fa-car Car]
    44	subgraph section
    45	C
    46	D
    47	E
    48	F
    49	G
    50	end`
    51	    const positioned = layoutGraphSync(parseGraph(source))
    52	    const group = positioned.groups.find(group => group.id === 'section')!
    53	    expect(group).toBeDefined()
    54	    for (const id of ['C', 'D', 'E', 'F', 'G']) {
    55	      const node = positioned.nodes.find(node => node.id === id)!
    56	      expect(node.x).toBeGreaterThanOrEqual(group.x)
    57	      expect(node.y).toBeGreaterThanOrEqual(group.y)
    58	      expect(node.x + node.width).toBeLessThanOrEqual(group.x + group.width)
    59	      expect(node.y + node.height).toBeLessThanOrEqual(group.y + group.height)
    60	    }
    61	    const svg = renderMermaidSVG(source)
    62	    expect(svg).toContain('iPhone')
    63	    expect(svg).toContain('section')
    64	  })
    65	  test.each(['LR', 'RL', 'TD', 'BT'] as const)('an internal fork continues its admitted centre trunk (%s)', direction => {
    66	    const graph = parseGraph(`flowchart ${direction}\nA-->C\nC-->D\nC-->E[Longer child]`)
    67	    const { nodes, edges, groups } = layoutGraphSync(graph)
    68	    const style = resolveRenderStyle()
    69	    const forks = edges.filter(edge => edge.source === 'C')
    70	    // The incoming route is explicitly centred so the test isolates the
    71	    // writer from upstream differences in which port a layout happens to use.
    72	    const incoming = edges.find(edge => edge.target === 'C')!
    73	    const start = sourceEmissionPort(nodes.find(node => node.id === 'A')!, direction, 0, 1)
    74	    const end = targetFlowPort(nodes.find(node => node.id === 'C')!, direction)
    75	    const { main } = layoutFlow(direction)
    76	    incoming.points = doglegBetween(start, end, direction, (start[main] + end[main]) / 2)
    77	    const bundled = bundleEdgePaths(edges, nodes, groups, graph.direction, style)
    78	    expect(forks.length).toBe(2)
    79	    expect(forks.every(edge => bundled.has(edge))).toBe(true)
    80	    const first = forks[0]!, second = forks[1]!
    81	    const trunk = first.points.slice(0, 2).map(point => ({ ...point }))
    82	    expect(second.points.slice(0, 2)).toEqual(trunk)
    83	    expect(Math.hypot(trunk[1]!.x - trunk[0]!.x, trunk[1]!.y - trunk[0]!.y)).toBeGreaterThan(0)
    84	    applySymmetricFanoutEmissions(nodes, edges, groups, graph, bundled, style)
    85	    expect(first.points.slice(0, 2)).toEqual(trunk)
    86	    expect(second.points.slice(0, 2)).toEqual(trunk)
    87	    expect(first.points[0]).not.toBe(second.points[0])
    88	    expect(first.points[1]).not.toBe(second.points[1])
    89	  })
    90	  test('peers with differing label widths are equalized to a common width and aligned', () => {
    91	    const p = parseMermaid(SYM)
    92	    expect(p.ok).toBe(true)
    93	    if (!p.ok) return
    94	    const layout = layoutMermaid(p.value)
    95	    const D = layout.nodes.find(n => n.id === 'D')!
    96	    const E = layout.nodes.find(n => n.id === 'E')!
    97	    expect(D).toBeDefined()
    98	    expect(E).toBeDefined()
    99	    // Equal width (both widened to the wider "warnings" box) ...
   100	    expect(D.w).toBe(E.w)
   101	    // ... and aligned on the main (flow) axis — LR ⇒ identical x.
   102	    expect(D.x).toBe(E.x)
   103	  })
   104	})
