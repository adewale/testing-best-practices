     3	/** Keep local regression settings in gates, but let finder/replay controls win. */
     4	export function fcParameters<T>(defaults: fc.Parameters<T> = {}): fc.Parameters<T> {
     5	  const parameters = { ...defaults }
     6	  const global = fc.readConfigureGlobal()
     7	  if (process.env.AM_FC_SEED !== undefined) {
     8	    // With AM_FC_SEED=random the preload leaves seed unset. Removing a local
     9	    // pin lets fast-check choose (and report) a fresh seed for this property.
    10	    if (global.seed === undefined) delete parameters.seed
    11	    else parameters.seed = global.seed
    12	  }
    13	  if (global.numRuns !== undefined) {
    14	    // Finder counts are a floor: never reduce an already stronger local run.
    15	    parameters.numRuns = Math.max(defaults.numRuns ?? 100, global.numRuns)
    16	  }
    17	  return parameters
    18	}
