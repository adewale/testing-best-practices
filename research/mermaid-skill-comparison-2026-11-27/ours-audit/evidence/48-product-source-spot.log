     1	// Tiny PNG pixel-inspection helper for raster tests. Wraps upng-js (already a
     2	// devDependency, used by the sketch-prototype scripts) so tests can decode
     3	// renderMermaidPNG output and scan for glyph ink without adding dependencies.
     4	
     5	// @ts-expect-error - upng-js ships no types
     6	import UPNG from 'upng-js'
     7	
     8	export interface DecodedPng {
     9	  width: number
    10	  height: number
    11	  /** RGBA8, row-major, 4 bytes per pixel. */
    12	  rgba: Uint8Array
    13	}
    14	
    15	export function decodePng(png: Uint8Array): DecodedPng {
    16	  const img = UPNG.decode(png.buffer.slice(png.byteOffset, png.byteOffset + png.byteLength))
    17	  const rgba = new Uint8Array(UPNG.toRGBA8(img)[0] as ArrayBuffer)
    18	  return { width: img.width as number, height: img.height as number, rgba }
    19	}
    20	
    21	/**
    22	 * Columns in [x0, x1) that contain at least one "ink" pixel (mean RGB below
    23	 * `threshold`) within rows [y0, y1). Near-black text ink scores ~0–60; white
    24	 * background and the pastel section/box fills score far above 100.
    25	 */
    26	export function inkColumns(img: DecodedPng, x0: number, x1: number, y0: number, y1: number, threshold = 100): number[] {
    27	  const cols: number[] = []
    28	  const yStart = Math.max(0, Math.floor(y0))
    29	  const yEnd = Math.min(img.height, Math.ceil(y1))
    30	  for (let x = Math.max(0, Math.floor(x0)); x < Math.min(img.width, Math.ceil(x1)); x++) {
    31	    for (let y = yStart; y < yEnd; y++) {
    32	      const i = (y * img.width + x) * 4
    33	      if ((img.rgba[i]! + img.rgba[i + 1]! + img.rgba[i + 2]!) / 3 < threshold) {
    34	        cols.push(x)
    35	        break
    36	      }
    37	    }
    38	  }
    39	  return cols
    40	}
