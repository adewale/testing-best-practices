     5	import { readdirSync, readFileSync, statSync } from 'node:fs'
     6	import { join } from 'node:path'
     7	import {
     8	  findUncoveredScriptsFromBuffers,
     9	  type UncoveredScript,
    10	} from './font-coverage-core.ts'
    11	
    12	const FONT_EXT = /\.(ttf|otf|ttc|otc)$/i
    13	
    14	function fontFilesUnder(directory: string, depth = 4): string[] {
    15	  if (depth < 0) return []
    16	  let entries: string[]
    17	  try {
    18	    entries = readdirSync(directory).sort()
    19	  } catch {
    20	    return []
    21	  }
    22	
    23	  const files: string[] = []
    24	  for (const entry of entries) {
    25	    const path = join(directory, entry)
    26	    try {
    27	      const stat = statSync(path)
    28	      if (stat.isDirectory()) files.push(...fontFilesUnder(path, depth - 1))
    29	      else if (FONT_EXT.test(entry)) files.push(path)
    30	    } catch {
    31	      // A missing or unreadable caller file contributes no coverage.
    32	    }
    33	  }
    34	  return files
    35	}
    36	
    37	function fontBuffersUnder(directories: readonly string[]): Uint8Array[] {
    38	  const buffers: Uint8Array[] = []
    39	  for (const directory of directories) {
    40	    for (const file of fontFilesUnder(directory)) {
    41	      try {
    42	        buffers.push(new Uint8Array(readFileSync(file)))
    43	      } catch {
    44	        // A missing or unreadable caller file contributes no coverage.
    45	      }
    46	    }
    47	  }
    48	  return buffers
    49	}
    50	
    51	/**
    52	 * Determine glyph coverage from the exact verified bundled buffers plus fonts
    53	 * in directories the caller explicitly opted into.
    54	 */
    55	export function findUncoveredScripts(
    56	  svg: string,
    57	  callerFontDirectories: readonly string[],
    58	  verifiedFontBuffers: readonly Uint8Array[],
    59	): UncoveredScript[] {
    60	  return findUncoveredScriptsFromBuffers(svg, [
    61	    ...verifiedFontBuffers,
    62	    ...fontBuffersUnder(callerFontDirectories),
    63	  ])
    64	}
