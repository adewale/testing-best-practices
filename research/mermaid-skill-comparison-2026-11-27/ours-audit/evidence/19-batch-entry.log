     2	import { pipeline } from 'node:stream/promises'
     3	
     4	/** Retain at most the current input line, output envelope and stream buffers.
     5	 * Pulling the next request waits for stdout capacity, including slow consumers. */
     6	export async function streamJsonlBatch(input: Readable, output: Writable, handler: (line: string, index: number) => unknown): Promise<void> {
     7	  input.setEncoding('utf8')
     8	  async function* responses(source: AsyncIterable<string | Buffer>) {
     9	    let pending = ''
    10	    let index = 0
    11	    const response = (line: string): string => {
    12	      let value: unknown
    13	      try {
    14	        value = handler(line, index++)
    15	      } catch (error) {
    16	        value = { ok: false, error: { code: 'BATCH_HANDLER_ERROR', message: error instanceof Error ? error.message : String(error) } }
    17	      }
    18	      return JSON.stringify(value) + '\n'
    19	    }
    20	    for await (const chunk of source) {
    21	      pending += chunk
    22	      let start = 0
    23	      let end: number
    24	      while ((end = pending.indexOf('\n', start)) !== -1) {
    25	        const line = pending.slice(start, end)
    26	        start = end + 1
    27	        if (line.trim() !== '') yield response(line)
    28	      }
    29	      pending = pending.slice(start)
    30	    }
    31	    if (pending.trim() !== '') yield response(pending)
    32	  }
    33	  // Finish an owned adapter so pipeline awaits the final write callback without
    34	  // ending shared stdout. end:false can resolve before that acknowledgement.
    35	  const writer = new Writable({ highWaterMark: 1, write(chunk, encoding, done) { output.write(chunk, encoding, done) } })
    36	  const onError = (error: Error) => { writer.destroy(error) }
    37	  const onClose = () => { writer.destroy(new Error('output closed before batch completed')) }
    38	  output.on('error', onError)
    39	  output.on('close', onClose)
    40	  try {
    41	    await pipeline(input, responses, writer)
    42	  } finally {
    43	    output.removeListener('error', onError)
    44	    output.removeListener('close', onClose)
    45	  }
    46	}
