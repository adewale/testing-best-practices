   413	      expect(installed.signature, source).toEqual([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a])
   414	      expect(installed.ihdr, source).toBe('IHDR')
   415	      expect(installed.width, source).toBeGreaterThan(0)
   416	      expect(installed.height, source).toBeGreaterThan(0)
   417	      const reference = renderMermaidPNG(source, options)
   418	      expect({ sha256: installed.sha256, length: installed.length }, source).toEqual({ sha256: sha(reference), length: reference.length })
   419	    })
   420	
   421	    // Bins are linked into node_modules/.bin.
   422	    expect(existsSync(binShimAm)).toBe(true)
   423	    expect(existsSync(binShimMcp)).toBe(true)
   424	
   425	    // Apache-2.0-derived Architecture icon paths reach actual recipients with
   426	    // both the attribution and the complete license, not merely files[] intent.
   427	    const notice = readFileSync(join(packageDir, 'THIRD_PARTY_NOTICES.md'), 'utf8')
   428	    const apache = readFileSync(join(packageDir, 'LICENSES', 'Apache-2.0.txt'), 'utf8')
   429	    expect(notice).toContain('LICENSES/Apache-2.0.txt')
   430	    expect(notice).toContain('contains no upstream `NOTICE` file')
   431	    expect(apache).toContain('Apache License\n                           Version 2.0, January 2004')
   432	  }, RUN_TIMEOUT_MS)
   433	})
   434	
   435	// ---------------------------------------------------------------------------
   436	// T2 — the `am` bin under Node.
   437	// ---------------------------------------------------------------------------
   438	describe('installed tarball — am bin', () => {
   439	  test('batch --jsonl: one result per line, bad lines never abort, ASCII matches source', () => {
   440	    expect(haveConsumer).toBe(true)
   441	    // Interleave valid ASCII-render ops (differential), other ops, and hostile
   442	    // lines (non-JSON, JSON-but-invalid) to prove the stream never aborts.
   443	    const flow = fc.sample(flowchartArb, 30)
   444	    const lines: string[] = []
   445	    const asciiAt = new Map<number, string>() // line index -> source
   446	    flow.forEach((src) => { asciiAt.set(lines.length, src); lines.push(JSON.stringify({ op: 'render', source: src, options: { format: 'ascii' } })) })
   447	    // Sample sources and ops in ONE draw each — `fc.sample(arb, 1)` inside a loop
   448	    // re-seeds from the pinned global seed every call and returns the same pick.
   449	    const mixedSrcs = fc.sample(mixedArb, 20)
   450	    const mixedOps = fc.sample(fc.constantFrom('render', 'verify', 'parse', 'serialize'), 20)
   451	    mixedSrcs.forEach((src, k) => lines.push(JSON.stringify({ op: mixedOps[k], source: src })))
   452	    const invalidAt = new Map<number, string>()
   453	    for (const [bad, code] of [
   454	      ['not json at all', 'INVALID_JSON'], ['{"op":123}', 'INVALID_PAYLOAD'],
   455	      ['{"nope":1}', 'INVALID_PAYLOAD'], ['[]', 'INVALID_PAYLOAD'], ['null', 'INVALID_PAYLOAD'],
   456	    ] as const) {
   457	      invalidAt.set(lines.length, code)
   458	      lines.push(bad)
   459	      // Recovery must reach a later valid request, not just terminate cleanly
   460	      // after an invalid final line.
   461	      asciiAt.set(lines.length, flow[0]!)
   462	      lines.push(JSON.stringify({ op: 'render', source: flow[0], options: { format: 'ascii' } }))
   463	    }
   464	
   465	    const r = spawnSync(NODE!, [amBin, 'batch', '--jsonl'], { cwd: work, input: lines.join('\n') + '\n', encoding: 'utf8', timeout: RUN_TIMEOUT_MS, maxBuffer: 64 * 1024 * 1024 })
   466	    expect(r.status).toBe(0) // clean exit; a segfault/panic would be 132/139
   467	    const out = r.stdout.split('\n').filter(Boolean)
   468	    expect(out.length).toBe(lines.length) // exactly one result per input line
   469	
   470	    const mismatches: unknown[] = []
   471	    out.forEach((line, i) => {
   472	      const res = JSON.parse(line) as { ok: boolean; op?: string; data?: { ascii?: string }; error?: { code?: string } }
   473	      expect(typeof res.ok).toBe('boolean')
   474	      if (!res.ok) expect(typeof res.error?.code).toBe('string')
   475	      if (invalidAt.has(i)) expect(res).toMatchObject({ ok: false, error: { code: invalidAt.get(i) } })
   476	      if (asciiAt.has(i)) {
   477	        // A valid flowchart ASCII render must SUCCEED and carry `ascii` — assert
   478	        // unconditionally so a regression that drops the field (still ok:true)
   479	        // can't let the differential pass vacuously.
   480	        expect(res.ok).toBe(true)
   481	        expect(typeof res.data?.ascii).toBe('string')
   482	        if (sha(res.data!.ascii!) !== refAscii(asciiAt.get(i)!)) mismatches.push({ i, src: asciiAt.get(i) })
   483	      }
   484	    })
   485	    expect(mismatches).toEqual([])
