    19	async function run(
    20	  command: string[],
    21	  options: { cwd: string; env?: Record<string, string | undefined>; requireTests?: boolean },
    22	): Promise<void> {
    23	  console.log(`$ ${command.join(' ')}`)
    24	  const child = Bun.spawn(command, {
    25	    cwd: options.cwd,
    26	    env: { ...process.env, ...options.env },
    27	    stdout: 'pipe',
    28	    stderr: 'pipe',
    29	  })
    30	  const [stdout, stderr, exitCode] = await Promise.all([
    31	    new Response(child.stdout).text(),
    32	    new Response(child.stderr).text(),
    33	    child.exited,
    34	  ])
    35	  if (stdout) process.stdout.write(stdout)
    36	  if (stderr) process.stderr.write(stderr)
    37	  if (exitCode !== 0) throw new Error(`Command exited ${exitCode}: ${command.join(' ')}`)
    38	  if (options.requireTests) {
    39	    const counts = [...`${stdout}\n${stderr}`.matchAll(/(?:^|\n)\s*(\d+) pass(?:\s|$)/g)]
    40	    const passed = counts.reduce((total, match) => total + Number(match[1]), 0)
    41	    if (passed === 0) throw new Error(`Browser contract executed zero passing tests: ${command.join(' ')}`)
    42	  }
    43	}
