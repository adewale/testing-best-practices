    61	async function paints(page: Page, html: string, containerId: string): Promise<string[]> {
    62	  await page.setContent(`<!doctype html><html><body>${html}</body></html>`)
    63	  return page.evaluate(({ id, properties }) => {
    64	    const root = document.getElementById(id)!.querySelector('svg')!
    65	    return [root, ...root.querySelectorAll('*')].map(element => {
    66	      const style = getComputedStyle(element)
    67	      return `${element.tagName}|${properties.map(name => style.getPropertyValue(name)).join('|')}`
    68	    })
    69	  }, { id: containerId, properties: PAINT_PROPERTIES })
    70	}
