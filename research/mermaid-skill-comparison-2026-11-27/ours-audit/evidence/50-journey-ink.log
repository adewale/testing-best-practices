   564	function renderTask<T>(marks: DrawingFactory<T>, task: PositionedJourneyTask, sectionLabel: string | undefined, style: ResolvedRenderStyle, paints: JourneyPaints): T {
   565	  const sectionAttr = sectionLabel ? ` data-section="${escapeAttr(sectionLabel)}"` : ''
   566	  const actorAttr = task.actors.length > 0 ? ` data-actors="${escapeAttr(task.actors.join(', '))}"` : ''
   567	  const value = task.score / JOURNEY_MAX_SCORE
   568	  const channels: SemanticChannels = sectionLabel ? { value, category: sectionLabel } : { value }
   569	  const children: Array<{ node: T; indent: number }> = [
   570	    { indent: 2, node: renderTrack(marks, task.track, task, style, paints) },
   571	    { indent: 2, node: renderTaskBox(marks, task, style, paints, channels) },
   572	    { indent: 2, node: renderTaskLabel(marks, task, style, paints, channels) },
   573	  ]
   574	
   575	  const actorOccurrences = new Map<string, number>()
   576	  for (const dot of task.actorDots) {
   577	    const key = dot.key ?? journeyActorKey(dot.label)
   578	    const occurrence = actorOccurrences.get(key) ?? 0
   579	    actorOccurrences.set(key, occurrence + 1)
   580	    children.push({ indent: 2, node: renderActorDot(marks, dot, task.id, occurrence, paints) })
   581	  }
   582	
   583	  children.push({ indent: 2, node: renderScoreMarker(marks, task.marker, task.id, paints, channels) })
   584	
   585	  return marks.group({
   586	    id: `task:${task.id}`,
   587	    role: 'task',
   588	    open: `<g class="journey-task" data-id="${escapeAttr(task.id)}" data-score="${task.score}"${sectionAttr}${actorAttr}>`,
   589	    close: '</g>',
   590	    children,
   591	    channels,
   592	  })
   593	}
