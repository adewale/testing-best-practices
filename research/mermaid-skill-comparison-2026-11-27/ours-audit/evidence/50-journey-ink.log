   223	  // qualify the warning rather than turning an unknown outcome into silence.
   224	  const emit = onWarning ?? ((w: PngRasterWarning) => process.stderr.write(`agentic-mermaid renderMermaidPNG: warning ${w.code}: ${w.message}\n`))
