    74	function cliStructuredRenderFailure(error: unknown, source?: string): CliStructuredFailure {
    75	  if (isCliStructuredFailure(error)) return error
    76	  return { ok: false, error: projectRenderErrorDiagnostic(error, { source }) }
    77	}
