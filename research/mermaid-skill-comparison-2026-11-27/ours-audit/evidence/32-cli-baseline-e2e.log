    79	/** A render failure is the caller's input (exit 2: the source, its
    80	 * configuration, or an option) unless the engine is at fault (exit 4). */
    81	function renderFailureExitCode(failure: CliStructuredFailure): number {
    82	  return failure.error.code === 'INTERNAL_ERROR' ? EXIT_INTERNAL : EXIT_ARG_ERROR
    83	}
