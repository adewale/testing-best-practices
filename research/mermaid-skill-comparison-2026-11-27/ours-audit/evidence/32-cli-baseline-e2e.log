    17	function runAm(args: string[], stdin = '', env: NodeJS.ProcessEnv = {}): { status: number; stdout: string; stderr: string } {
    18	  const r = spawnSync('bun', ['run', AM, ...args], {
    19	    encoding: 'utf8',
    20	    input: stdin,
    21	    env: { ...process.env, ...env },
    22	    timeout: SPAWN_TIMEOUT_MS,
    23	  })
    24	  return { status: r.status ?? -1, stdout: r.stdout, stderr: r.stderr }
    25	}
