   163	    const unsupported = JSON.stringify({ op: 'mutate', source: 'pie\n  Dogs : 3', mutation: { kind: 'add_node', id: 'X', label: 'X' } })
   164	    const stdin = [valid, unsupported].join('\n') + '\n'
   165	
   166	    const { status, stdout } = runAm(['batch'], stdin)
