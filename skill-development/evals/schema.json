{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "testing-best-practices eval suite",
  "type": "object",
  "required": ["skill_name", "version", "how_to_use", "evals"],
  "properties": {
    "skill_name": { "const": "testing-best-practices" },
    "version": { "type": "integer", "minimum": 1 },
    "how_to_use": { "type": "string", "minLength": 20 },
    "evals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "critical",
          "mode",
          "taxonomy",
          "prompt",
          "fixture",
          "expected_behavior",
          "red_flags",
          "rubric_focus",
          "measurement",
          "validity",
          "eval_health"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^E[0-9]{2}-[a-z0-9-]+$" },
          "critical": { "type": "boolean" },
          "hidden": { "type": "boolean" },
          "mode": { "enum": ["write", "assess", "upgrade", "detect"] },
          "taxonomy": {
            "type": "object",
            "required": ["language_framework", "techniques", "risk_classes", "failure_modes"],
            "properties": {
              "language_framework": { "type": "string", "minLength": 2 },
              "techniques": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
              "risk_classes": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
              "failure_modes": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true }
            },
            "additionalProperties": false
          },
          "prompt": { "type": "string", "minLength": 20 },
          "fixture": { "type": "string", "minLength": 10 },
          "expected_behavior": { "type": "array", "minItems": 2, "items": { "type": "string" } },
          "red_flags": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "rubric_focus": { "type": "array", "minItems": 1, "items": { "enum": ["A", "B", "C", "D", "E", "F", "G", "H"] }, "uniqueItems": true },
          "measurement": {
            "type": "object",
            "required": ["static_checks", "runtime_checks", "judge_checks"],
            "properties": {
              "static_checks": { "type": "array", "items": { "type": "string" } },
              "runtime_checks": { "type": "array", "items": { "type": "string" } },
              "judge_checks": { "type": "array", "minItems": 1, "items": { "type": "string" } }
            },
            "additionalProperties": false
          },
          "validity": {
            "type": "object",
            "required": ["claim", "warrant", "backing", "rebuttals"],
            "properties": {
              "claim": { "type": "string", "minLength": 20 },
              "warrant": { "type": "string", "minLength": 20 },
              "backing": {},
              "rebuttals": { "type": "array", "minItems": 1, "items": { "type": "string" } }
            },
            "additionalProperties": false
          },
          "eval_health": {
            "type": "object",
            "required": ["difficulty", "saturation_status", "known_discriminates_versions", "last_reviewed"],
            "properties": {
              "difficulty": { "enum": ["easy", "medium", "hard", "adversarial"] },
              "saturation_status": { "enum": ["unknown", "saturated_public", "hidden_probe", "active", "retired"] },
              "known_discriminates_versions": { "type": "array", "items": { "type": "string" } },
              "last_reviewed": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
